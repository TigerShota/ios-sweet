diff --git a/bsd/dev/gauguin_gpu.c b/bsd/dev/gauguin_gpu.c
--- a/bsd/dev/gauguin_gpu.c
+++ b/bsd/dev/gauguin_gpu.c
@@ -3437,6 +3437,32 @@
 /* 0215: gauguinregs, default 0 - at a wedge the register block may be gone. */
 static int gg_regs_opt = -1;
 
+/*
+ * 0216: two directed switches for the deterministic stop at IB 0x40107d3c + 2801
+ * (fence 0x6000236, every boot): gauguinnullidx=1 zeroes the index count of
+ * every CP_DRAW_INDX_OFFSET in the copy (payload 3 of the 7-dword form, payload
+ * 0 of the 3-dword form), gauguinnulldraw=1 NOPs the whole packet. If the
+ * `rem` starts moving with the count zeroed, the index fetch is what blocks the
+ * ME; if only NOPing the draw moves it, the draw itself is the blocker.
+ */
+static int gg_nidx_opt = -1;
+static int gg_ndraw_opt = -1;
+static int gg_ndraw_log;
+
+static int
+gg_boot_int(const char *name, int def, int *slot)
+{
+	if (*slot == -1) {
+		int v = def;
+
+		*slot = PE_parse_boot_argn(name, &v, sizeof(v)) ? v : def;
+	}
+	return *slot;
+}
+
+/* 0216: memory post-mortems are only useful for the first wedges. */
+static uint32_t gg_mem_n;
+
 static int
 gg_regs_enabled(void)
 {
@@ -4789,6 +4815,42 @@
 			}
 		}
 		}
+		/*
+		 * 0216: the stop is deterministic (IB 0x40107d3c + 2801, the same
+		 * 4096-dword-aligned read for 345 consecutive fences), so instead of
+		 * more post-mortems, offer two length-preserving edits that isolate
+		 * the index fetch from the draw: zero the index count of every
+		 * CP_DRAW_INDX_OFFSET (payload 3 of the 7-dword form - the field that
+		 * carries 0x150/0x390/0x8d0 in v166 - and payload 0 of the 3-dword
+		 * form, which carries 0x186), or NOP the packet outright.
+		 */
+		if (type == 7u && op == 0x38u) {
+			uint32_t base = *np - len;
+
+			if (gg_boot_int("gauguinnulldraw", 0, &gg_ndraw_opt) != 0) {
+				out[base] = gg_pkt7(CP_NOP, plen);
+				for (k = 1; k < len; ++k) {
+					out[base + k] = 0u;
+				}
+				if (gg_ndraw_log < 4) {
+					gg_ndraw_log++;
+					printf("GAUGUIN CP: 0216 draw nop at=%u"
+					    " plen=%u\n", base, plen);
+				}
+			} else if (gg_boot_int("gauguinnullidx", 0,
+			    &gg_nidx_opt) != 0) {
+				if (plen == 7u) {
+					out[base + 4u] = 0u;
+				} else if (plen == 3u) {
+					out[base + 1u] = 0u;
+				}
+				if (gg_ndraw_log < 4) {
+					gg_ndraw_log++;
+					printf("GAUGUIN CP: 0216 idx0 at=%u"
+					    " plen=%u\n", base, plen);
+				}
+			}
+		}
 		at = *np;
 		out[(*np)++] = gg_pkt7(CP_EVENT_WRITE, 4u);
 		out[(*np)++] = 0x04u;
