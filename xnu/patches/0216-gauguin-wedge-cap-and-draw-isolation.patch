-				    va_seen < GG_MEM_VA_MAX) {
-					va_seen++;
-					printf("GAUGUIN CP: 0215 va ib=%u off=%u"
-					    " v=%#x gem=%d\n", k, o + j, v,
-					    gg_gem_pa(v) != 0u ? 1 : 0);
+				/*
+				 * 0216: PM4 headers and the stamp markers are also
+				 * >= 0x40000000, so v165's scan was pure noise. Only a
+				 * 1 KiB-aligned word can be a buffer base, and the two
+				 * windows mean different things: 0x40000000..0x4fffffff
+				 * is the CP's own ring/IB/mark window (kernel mapped, no
+				 * GEM entry - gem=- means "not applicable", not "missing"),
+				 * 0x50000000..0x6fffffff is the GEM window this driver
+				 * pages in itself.
+				 */
+				if (v < 0x40000000u || v >= 0x80000000u ||
+				    (v & 0x3ffu) != 0u) {
+					continue;
+				}
+				if (v < 0x50000000u) {
+					cp_n++;
+					if (cp_n <= 8u) {
+						printf("GAUGUIN CP: 0216 va area=cp"
+						    " ib=%u off=%u v=%#x gem=-\n",
+						    k, o + j, v);
+					}
+					continue;
+				}
+				if (v >= 0x70000000u) {
