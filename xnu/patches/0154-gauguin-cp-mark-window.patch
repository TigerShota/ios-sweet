+/*
+ * 0154: map an offset inside an annotated copy back to the original buffer.
+ * The copy is the original stream with a 5-dword stamp after every packet, so
+ * one walk over the copy recovers the original offset. Needed because
+ * CP_IB1_REM_SIZE counts dwords of the copy, not of the original IB.
+ */
+static uint32_t
+gg_mark_origin(uint32_t index, uint32_t at)
+{
+	volatile uint32_t *p = (volatile uint32_t *)(mark_mem + GG_MARK_IB +
+	    index * GG_MARK_STEP);
+	uint32_t n = 0, o = 0;
+
+	while (n < at) {
+		uint32_t h = p[n];
+		uint32_t type = h >> 28;
+		uint32_t plen, len;
+
+		if (type == 7u) {
+			plen = h & 0x3fffu;
+		} else if (type == 4u) {
+			plen = h & 0x7fu;
+		} else if (type == 0u) {
+			plen = ((h >> 16) & 0x3fffu) + 1u;
+		} else {
+			break;
+		}
+		len = 1u + plen;
+		if (n + len > at) {
+			return o + (at - n);
+		}
+		n += len;
+		o += len;
+		if (n + 5u > at) {
+			break;
+		}
+		n += 5u;
+	}
+	return o;
