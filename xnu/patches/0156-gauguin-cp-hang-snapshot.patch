 /*
+ * 0156: CP_WAIT_FOR_IDLE only returns once every block reports idle, and v111
+ * hangs inside exactly that packet. Print which RBBM_STATUS bits are still set
+ * (bit names from a6xx.xml) instead of a bare hex word.
+ */
+static void
+gg_rbbm_busy(void)
+{
+	static const char *const names[24] = {
+		"CP_AHB_CX", "CP_AHB_CP", "CP", "DBGC", "VBIF", "TSE", "RAS",
+		"RB", "CCU", "A2D", "LRZ", "COM", "PC_DCALL", "PC_VSD", "TESS",
+		"VFD", "VPC", "UCHE", "SP", "TPL1", "VSC", "HLSQ",
+		"GPU_BUSY_CP", "GPU_BUSY"
+	};
+	uint32_t v = gg_rd(gg.gpu, GR(A6XX_RBBM_STATUS_DW));
+	uint32_t b;
+
+	printf("GAUGUIN CP: rbbm busy=%#x [", v);
+	for (b = 0; b < 24u; b++) {
+		if (v & (1u << b)) {
+			printf("%s ", names[b]);
+		}
+	}
+	printf("]\n");
+}
