+static uint32_t
+gg_flat_rd(uint64_t iova, uint32_t o)
+{
+	vm_offset_t a = gg_san_map(iova + 4u * (uint64_t)o);
+
+	return a != 0 ? *(volatile uint32_t *)a : 0u;
+}
+
+static int
+gg_flat_copy(uint32_t index, uint64_t iova, uint32_t dwords,
+    volatile uint32_t *out, uint32_t max, uint32_t *np, int depth)
+{
+	uint32_t o = 0, k;
+
+	if (depth > GG_FLAT_DEPTH) {
+		return 0;
+	}
+	while (o < dwords) {
+		uint32_t h = gg_flat_rd(iova, o);
+		uint32_t type = h >> 28;
+		uint32_t op = (h >> 16) & 0x7fu;
+		uint32_t plen, len;
+		int isind, ind;
+
+		if (type == 7u) {
+			plen = h & 0x3fffu;
+		} else if (type == 4u) {
+			plen = h & 0x7fu;
+		} else if (type == 0u) {
+			plen = ((h >> 16) & 0x3fffu) + 1u;
+		} else {
+			return 0;
+		}
+		len = 1u + plen;
+		if (o + len > dwords) {
+			return 0;
+		}
+		isind = (type == 7u && (op == CP_INDIRECT_BUFFER ||
+		    op == 0x37u || op == 0x63u));
+		ind = isind && plen >= 3u;
+		if (ind) {
+			uint64_t niova = ((uint64_t)gg_flat_rd(iova, o + 2u) << 32) |
+			    gg_flat_rd(iova, o + 1u);
+			uint32_t nst = gg_flat_rd(iova, o + 3u);
+			uint32_t before = *np;
+
+			if (depth < GG_FLAT_DEPTH && nst != 0u &&
+			    nst <= GG_FLAT_MAX && gg_gem_pa(niova) != 0u) {
+				gg_flat_nib++;
+				if (gg_flat_copy(index, niova, nst, out, max,
+				    np, depth + 1)) {
+					o += len;
+					continue;
+				}
+				*np = before;
+			}
+		}
+		if (*np + len + 5u > max) {
+			return 0;
+		}
+		for (k = 0; k < len; ++k) {
+			out[(*np)++] = isind ?
+			    (k == 0u ? gg_pkt7(CP_NOP, plen) : 0u) :
+			    gg_flat_rd(iova, o + k);
+		}
+		if (isind) {
+			gg_flat_nop++;
+		}
+		out[(*np)++] = gg_pkt7(CP_EVENT_WRITE, 4u);
+		out[(*np)++] = 0x04u;
+		out[(*np)++] = CP_VA_MARK + GG_MARK_BASE + 4u * index;
+		out[(*np)++] = 0u;
+		out[(*np)++] = 0x4d000000u | ((index & 0x3fu) << 16) |
+		    ((o + len) & 0xffffu);
+		o += len;
+	}
+	return 1;
+}
