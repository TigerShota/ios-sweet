+/*
+ * 0241: count what is actually inside a GPU VA. v200 painted both surfaces six
+ * times and still saw zeros at the next present, so the question is no longer
+ * "did the draw run" but "was the triangle ever in that buffer, and who removed
+ * it afterwards".
+ */
+static void
+gg_va_scan(const char *tag, uint32_t va, uint32_t ndw)
+{
+	uint32_t i, nz = 0u, first = 0u, fv = 0u;
+
+	for (i = 0u; i < ndw; i++) {
+		uint32_t v = gg_flat_rd(va, i);
+
+		if (v != 0u) {
+			if (nz == 0u) {
+				first = 4u * i;
+				fv = v;
+			}
+			nz++;
+		}
+	}
+	printf("GAUGUIN CP: 0241 scan %s va=%#x nz=%u first=%#x val=%#x\n",
+	    tag, va, nz, first, fv);
+	(void)sweet_log_flush_now();
 }
 
