+/*
+ * 0194: gg_ib_sanitize() clipped every GEM IB to the first 4 KiB page
+ * (room = (GEM_PAGE - offset)/4), so any packet past dword 1024 was never
+ * rewritten. v141 proved it: the 2411-dword UI IB 0x56162000 was sanitized
+ * only up to off=1018, while 0191 pinned the hard stop at off=1359 -- the
+ * 0x8103 GRAS_LRZ_BUFFER_BASE type-4 write. 0192 fired 8 NOPs on OTHER
+ * short IBs and the stop did not move a single dword. The mark window is a
+ * flat WCOMB alias (ismark), so it keeps using m + 4*o; GEM IBs now resolve
+ * each dword through the bounded page cache and can span every page.
+ */
+#define GG_SAN_MAX_DW 8192u
+
+static uint32_t
+gg_san_rd2(uint64_t iova, vm_offset_t m, int ismark, uint32_t o)
+{
+	vm_offset_t a = ismark ? m + 4u * (vm_offset_t)o :
+	    gg_san_map(iova + 4u * (uint64_t)o);
+
+	return a != 0 ? *(volatile uint32_t *)a : 0u;
+}
+
+static void
+gg_san_wr2(uint64_t iova, vm_offset_t m, int ismark, uint32_t o, uint32_t v)
+{
+	vm_offset_t a = ismark ? m + 4u * (vm_offset_t)o :
+	    gg_san_map(iova + 4u * (uint64_t)o);
+
+	if (a != 0) {
+		*(volatile uint32_t *)a = v;
+	}
+}
