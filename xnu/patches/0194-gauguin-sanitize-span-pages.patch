+static uint32_t
+gg_san_rd(uint64_t iova, uint32_t o)
+{
+	vm_offset_t m = gg_san_map(iova + 4u * (uint64_t)o);
+
+	return m != 0 ? *(volatile uint32_t *)m : 0u;
+}
