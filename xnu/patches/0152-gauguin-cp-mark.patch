 /*
+ * 0152: instrumented replay. v107 proved every packet of the IB the CP dies in
+ * (0x5045e000, 72 dwords) decodes cleanly, yet CP_INTERRUPT_STATUS reports
+ * CP_HW_FAULT_ERROR with CP_HW_FAULT bit 18 and the ME never retires another
+ * fence. Packet encoding is therefore not the question any more - which packet
+ * kills the ME is. When gauguinmark=1 each command buffer is copied into the
+ * CP scratch block with a CP_EVENT_WRITE stamp after every packet; the last
+ * stamp the GPU wrote names the next packet, i.e. the one that faulted.
+ * Layout inside CPMEM_SCRATCH (all CP-addressable): stamp word at 0x800,
+ * one 2 KiB copy region per IB from 0x1000.
+ */
+#define GG_MARK_BASE   0x800u
+#define GG_MARK_IB     0x1000u
+#define GG_MARK_STEP   0x800u	/* bytes per IB copy */
+#define GG_MARK_MAX    480u	/* dwords per annotated copy */
+#define GG_MARK_IBS    6u	/* 0x1000 + 6 * 0x800 == end of scratch */
+
+static int gg_mark_opt = -1;	/* -1 unparsed, 0 off, 1 annotate */
+
+/*
+ * Copy one command buffer, inserting a stamp packet after every complete PM4
+ * packet. Returns the number of dwords written, 0 when the buffer cannot be
+ * read through the GEM window or does not fit.
+ */
+static uint32_t
+gg_ib_annotate(uint32_t index, uint64_t iova, uint32_t dwords,
+    volatile uint32_t *out, uint32_t max)
+{
+	vm_offset_t m;
+	uint32_t room, o = 0, n = 0;
+
+	/*
+	 * Never hand the CP a partial copy: a buffer that is bigger than the slot
+	 * or runs off its page is submitted untouched instead.
+	 */
+	if (dwords == 0u || dwords > GG_MARK_MAX) {
+		return 0;
+	}
+	room = gg_ib_room(iova, dwords);
+	if (room != dwords) {
+		return 0;
+	}
+	m = gg_ib_map(iova, dwords);
+	if (m == 0) {
+		return 0;
+	}
+	while (o < dwords) {
+		uint32_t h = *(volatile uint32_t *)(m + 4u * o);
+		uint32_t type = h >> 28;
+		uint32_t plen, len, k;
+
+		if (type == 7u) {
+			plen = h & 0x3fffu;
+		} else if (type == 4u) {
+			plen = h & 0x7fu;
+		} else if (type == 0u) {
+			plen = ((h >> 16) & 0x3fffu) + 1u;
+		} else {
+			return 0;
+		}
+		len = 1u + plen;
+		if (o + len > dwords || n + len + 5u > max) {
+			return 0;
+		}
+		for (k = 0; k < len; ++k) {
+			out[n++] = *(volatile uint32_t *)(m + 4u * (o + k));
+		}
+		out[n++] = gg_pkt7(CP_EVENT_WRITE, 4u);
+		out[n++] = 0x04u;
+		out[n++] = CP_VA_SCRATCH + GG_MARK_BASE;
+		out[n++] = 0u;
+		out[n++] = 0x4d000000u | ((index & 0x3fu) << 16) |
+		    ((o + len) & 0xffffu);
+		o += len;
+	}
+	return n;
+}
+
