+/*
+ * 0196: read one 32-bit word through an uncached ml_io_map view of the
+ * physical page behind a kernel virtual address. v143 proved the CP wedge
+ * is gone (HUNG/STUCK/stop = 0, 409 submits, panic 0) but SWEET FB: src px
+ * is still all zero. present() memcpy()s from a cached CPU mapping and the
+ * driver's cpu_prep/bo_sync do no cache maintenance when patience_ns == 0,
+ * so a real GPU write could be invisible to the CPU. SweetFramebuffer prints
+ * this value next to the cached texel: non-zero uncached => stale cache,
+ * zero uncached => the GPU never wrote (over-NOPing / render-target bind).
+ * Four cached pages, no unmap needed for a boot-long diagnostic.
+ */
+uint32_t
+gauguin_uncached_read(uint64_t kva)
+{
+	static struct {
+		ppnum_t pn;
+		vm_offset_t base;
+	} uc[4];
+	static unsigned rot;
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)kva);
+	vm_offset_t m;
+	int i;
+
+	if (pn == 0) {
+		return 0;
+	}
+	for (i = 0; i < 4; ++i) {
+		if (uc[i].pn == pn && uc[i].base != 0) {
+			return *(volatile uint32_t *)(uc[i].base +
+			    (vm_offset_t)(kva & 0xfffu));
+		}
+	}
+	m = ml_io_map((vm_offset_t)(ptoa_64(pn) & ~0xfffull), 0x1000);
+	if (m == 0) {
+		return 0;
+	}
+	i = (int)(rot++ % 4);
+	uc[i].pn = pn;
+	uc[i].base = m;
+	return *(volatile uint32_t *)(m + (vm_offset_t)(kva & 0xfffu));
+}
