+/*
+ * 0193: every temporary CPU view of a GEM page called ml_io_map() and was
+ * never unmapped. sanitize and the IB dumps run on every submit (571 submits
+ * in v140), which filled the 8 MiB io_submap; late userspace maps then died
+ * with kmem_alloc(16384) failed with 3 (KERN_NO_SPACE) -> panic(cpu 4).
+ * Share one bounded cache and unmap a slot before reusing it, so live
+ * mappings stay under GG_TMP_PG_N * 4 KiB. Every caller consumes the pointer
+ * immediately, so rotation cannot invalidate a view still in use. Boot-time
+ * one-shot mappings (scan probe, mark_rd, panel_rd) are left alone.
+ */
+#define GG_TMP_PG_N 32
+#if defined(__arm64__)
+/* 0195: x86_64 has no ml_io_unmap; the phone kernel is arm64. */
+extern void ml_io_unmap(vm_offset_t, vm_size_t);
+#endif
+
+static struct {
+	uint64_t pa;
+	vm_offset_t base;
+} gg_tmp_pg[GG_TMP_PG_N];
+static int gg_tmp_pg_n;
+static unsigned gg_tmp_rot;
+static int gg_tmp_unmap_log;
+
+static vm_offset_t
+gg_tmp_map(uint64_t pa)
+{
+	vm_offset_t base;
+	int i;
+
+	pa &= ~0xfffull;
+	for (i = 0; i < gg_tmp_pg_n; ++i) {
+		if (gg_tmp_pg[i].pa == pa) {
+			return gg_tmp_pg[i].base;
+		}
+	}
+	base = ml_io_map((vm_offset_t)pa, GEM_PAGE);
+	if (base == 0) {
+		return 0;
+	}
+	if (gg_tmp_pg_n < GG_TMP_PG_N) {
+		i = gg_tmp_pg_n++;
+	} else {
+		i = (int)(gg_tmp_rot++ % GG_TMP_PG_N);
+		if (gg_tmp_pg[i].base != 0) {
+#if defined(__arm64__)
+			ml_io_unmap(gg_tmp_pg[i].base, GEM_PAGE);
+#endif
+			if (gg_tmp_unmap_log < 4) {
+				gg_tmp_unmap_log++;
+				printf("GAUGUIN CP: 0193 io cache unmap"
+				    " base=%#llx pa=%#llx\n",
+				    (unsigned long long)gg_tmp_pg[i].base,
+				    (unsigned long long)gg_tmp_pg[i].pa);
+			}
+		}
+	}
+	gg_tmp_pg[i].pa = pa;
+	gg_tmp_pg[i].base = base;
+	return base;
+}
