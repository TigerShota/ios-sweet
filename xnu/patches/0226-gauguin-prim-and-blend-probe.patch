+/*
+ * 0226: the raster state turned out to be correct (v182's healthy dump has
+ * GRAS_VPORT0 = 562.5 / 1218 with YSCALE -1218 and a 1124x2435 scissor, i.e. the
+ * full 1125x2436 surface), yet no word of RB_MRT0_BASE is ever written. The
+ * cheapest split left is the primitive itself: gauguindrawprim=N rewrites
+ * PRIM_TYPE (draw0 bits 5:0) of every started draw, so N=9 (DI_PT_POINTLIST)
+ * turns the two rect-list vertices into two points. Two dots on screen means
+ * vertices, viewport, FS and ROP all work and only RECTLIST expansion is
+ * missing; nothing at all means the draw never reaches the RB.
+ */
+static int gg_drawprim_opt = -2;
+
+static int
+gg_drawprim(void)
+{
+	if (gg_drawprim_opt == -2) {
+		int v = -1;
+		int got = PE_parse_boot_argn("gauguindrawprim", &v, sizeof(v));
+
+		gg_drawprim_opt = got ? v : -1;
+		printf("GAUGUIN CP: 0226 drawprim parse got=%d val=%d\n", got,
+		    gg_drawprim_opt);
+	}
+	return gg_drawprim_opt;
+}
+
 static int
 gg_boot_int(const char *name, int def, int *slot)
 {
