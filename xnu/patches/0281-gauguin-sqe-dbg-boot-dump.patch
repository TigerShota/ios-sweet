  * 0142: the CP stops retiring fences after v96's first frames (rptr==wptr,
@@ -5882,7 +5937,7 @@ gg_ib_sanitize(uint64_t iova, uint32_t dwords, int depth)
 			gg_imem_opt = PE_parse_boot_argn("gauguinimem",
 			    &v, sizeof(v)) ? v : -1;
 			if (gg_imem_opt >= 0) {
-				printf("GAUGUIN CP: 0280 imem val=%d armed\n",
+				printf("GAUGUIN CP: 0281 imem val=%d armed\n",
 				    gg_imem_opt);
 			}
 		}
@@ -8692,6 +8747,17 @@ gauguin_cp_submit(const uint64_t * addresses, const uint32_t * words, uint32_t c
 	    count == 0 || count > 64) {
 		return 0;
 	}
+	/*
+	 * 0281: ph0/ph1 at submit entry. ph0 = submit 0, before any ring
+	 * write (ME has not seen any work this boot); ph1 = submit 1,
+	 * after submit 0 completed. ph2 (the v241 point) samples after the
+	 * ME consumed ring work. Restore image present at ph0 -> boot-time
+	 * load; appears only by ph2 -> ME-execution driven.
+	 */
+	if (gg_imem_opt >= 0 && gg_submit_seen < 2) {
+		gg_sqe_dump(gg_submit_seen);
+		gg_submit_seen++;
+	}
 	need = 4u * count + 13u;	/* + 2 invalidates, + scratch, + RB_CCU_CNTL */
 	if (gg_wai_opt < 0) {
 		int wai = 0;
@@ -9685,57 +9751,12 @@ gauguin_cp_submit(const uint64_t * addresses, const uint32_t * words, uint32_t c
 	    gg_rd(gg.gpucc, GPUCC_GMU_CBCR));
 	gg_rbbm_busy();
 	/*
-	 * 0280: the hang-printout "PC" pair is a static readback, not a
-	 * PC: the pre-state diag writes CP_SQE_UCODE_DBG_ADDR and
-	 * CP_SQE_STAT_ADDR 0..3 and each DATA read auto-increments the
-	 * port, so every HUNG printout replays ADDR=4 DATA=IMEM[4] /
-	 * bank[4] - bit-identical across v237/v239/v240 AND v131-133
-	 * (0x4:0x2883003f).  Dump the whole SQE IMEM once at the first
-	 * hang, then probe the DMEM select (bit 16); per-word ADDR write
-	 * + DATA read is correct whether or not the port auto-increments.
+	 * 0281: ph2 keeps the v241 sample point (first hang printout; the
+	 * ME has consumed ring work) and reuses the shared dump body.
 	 */
 	if (gg_imem_opt >= 0 && gg_imem_done == 0) {
-		uint32_t a, v0, v1, v2, v3;
-
 		gg_imem_done = 1;
-		v0 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_ADDR_DW));
-		v1 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_DATA_DW));
-		v2 = gg_rd(gg.gpu, GR(CP_SQE_STAT_ADDR_DW));
-		v3 = gg_rd(gg.gpu, GR(CP_SQE_STAT_DATA_DW));
-		printf("GAUGUIN CP: 0280 readback ucode=%#x:%#x"
-		    " stat=%#x:%#x\n", v0, v1, v2, v3);
-		(void)sweet_log_flush_now();
-		for (a = 0u; a < 8192u; a += 4u) {
-			gg_wr(gg.gpu, GR(CP_SQE_UCODE_DBG_ADDR_DW), a);
-			v0 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_DATA_DW));
-			gg_wr(gg.gpu, GR(CP_SQE_UCODE_DBG_ADDR_DW), a + 1u);
-			v1 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_DATA_DW));
-			gg_wr(gg.gpu, GR(CP_SQE_UCODE_DBG_ADDR_DW), a + 2u);
-			v2 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_DATA_DW));
-			gg_wr(gg.gpu, GR(CP_SQE_UCODE_DBG_ADDR_DW), a + 3u);
-			v3 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_DATA_DW));
-			printf("GAUGUIN CP: 0280 imem[%04x]=%08x %08x %08x"
-			    " %08x\n", a, v0, v1, v2, v3);
-		}
-		(void)sweet_log_flush_now();
-		for (a = 0u; a < 1024u; a += 4u) {
-			gg_wr(gg.gpu, GR(CP_SQE_UCODE_DBG_ADDR_DW),
-			    a | 0x10000u);
-			v0 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_DATA_DW));
-			gg_wr(gg.gpu, GR(CP_SQE_UCODE_DBG_ADDR_DW),
-			    (a + 1u) | 0x10000u);
-			v1 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_DATA_DW));
-			gg_wr(gg.gpu, GR(CP_SQE_UCODE_DBG_ADDR_DW),
-			    (a + 2u) | 0x10000u);
-			v2 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_DATA_DW));
-			gg_wr(gg.gpu, GR(CP_SQE_UCODE_DBG_ADDR_DW),
-			    (a + 3u) | 0x10000u);
-			v3 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_DATA_DW));
-			printf("GAUGUIN CP: 0280 dmem[%04x]=%08x %08x %08x"
-			    " %08x\n", a, v0, v1, v2, v3);
-		}
-		(void)sweet_log_flush_now();
-		printf("GAUGUIN CP: 0280 imem dump done\n");
+		gg_sqe_dump(2);
 	}
 	gg_rbbm_busy();
 	if (gg_ib_dump_log < 2) {
