From: Trae <trae@local>
Subject: [PATCH] 0281: gauguin - SQE dbg dump at submit 0/1/2

t12 verdict: the second icache fetch space holds the SQE on-chip
ROM context-restore/GMEM-resolve firmware; 27 of its lines were
resident in the v241 0280 dump, but that dump fires after
gg_rbbm_busy() inside the first reaching submit - well after the
ME has consumed ring work - so the restore trigger is
unresolved: boot/init vs first-submit ME execution. 0281 lifts
the dump body into gg_sqe_dump(ph) and fires it three times:
ph0 at the first valid gauguin_cp_submit entry (ME has seen no
submit), ph2 at the v241 baseline point, ph1 at the second
submit entry. Pre-registered read: ph0 s1=0 & ph2 s1>0 ->
restore runs inside the first submit; ph0 s1>0 -> loaded during
boot/init; all-zero -> denser sampling needed. Same boot arg
gauguinimem=1, cmdline 567.
---
diff --git a/bsd/dev/gauguin_gpu.c b/bsd/dev/gauguin_gpu.c
--- a/bsd/dev/gauguin_gpu.c
+++ b/bsd/dev/gauguin_gpu.c
@@ -3415,8 +3415,63 @@ static int gg_state_log;
 static int gg_hung_log;
 static int gg_ib_dump_log;
 static int gg_wrap_log;
-static int gg_imem_opt = -2;	/* 0280: -2 unparsed, -1 off, >=0 on */
-static int gg_imem_done;
+static int gg_imem_opt = -2;	/* 0281: -2 unparsed, -1 off, >=0 on */
+static int gg_imem_done;	/* 0281: ph2 (v241 point) fired */
+static int gg_submit_seen;	/* 0281: ph0/ph1 fire at submit 0/1 entry */
+
+/*
+ * 0281: three-point SQE icache sampling to time the on-chip ROM context
+ * restore. ph0 fires at the entry of the first submit (before any ring
+ * work is written - the ME has not seen any command this boot), ph1 at
+ * the entry of the second submit (after submit 0 completed), ph2 at the
+ * v241 point (first hang printout, the ME has consumed ring work). If
+ * the space-1 (ROM restore) tag image appears only by ph2, the restore
+ * is ME-execution driven; already present at ph0 means boot-time load.
+ */
+static void
+gg_sqe_dump(int ph)
+{
+	uint32_t a, v0, v1, v2, v3;
+
+	v0 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_ADDR_DW));
+	v1 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_DATA_DW));
+	v2 = gg_rd(gg.gpu, GR(CP_SQE_STAT_ADDR_DW));
+	v3 = gg_rd(gg.gpu, GR(CP_SQE_STAT_DATA_DW));
+	printf("GAUGUIN CP: 0281 ph%d readback ucode=%#x:%#x"
+	    " stat=%#x:%#x\n", ph, v0, v1, v2, v3);
+	(void)sweet_log_flush_now();
+	for (a = 0u; a < 8192u; a += 4u) {
+		gg_wr(gg.gpu, GR(CP_SQE_UCODE_DBG_ADDR_DW), a);
+		v0 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_DATA_DW));
+		gg_wr(gg.gpu, GR(CP_SQE_UCODE_DBG_ADDR_DW), a + 1u);
+		v1 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_DATA_DW));
+		gg_wr(gg.gpu, GR(CP_SQE_UCODE_DBG_ADDR_DW), a + 2u);
+		v2 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_DATA_DW));
+		gg_wr(gg.gpu, GR(CP_SQE_UCODE_DBG_ADDR_DW), a + 3u);
+		v3 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_DATA_DW));
+		printf("GAUGUIN CP: 0281 ph%d imem[%04x]=%08x %08x %08x"
+		    " %08x\n", ph, a, v0, v1, v2, v3);
+	}
+	(void)sweet_log_flush_now();
+	for (a = 0u; a < 1024u; a += 4u) {
+		gg_wr(gg.gpu, GR(CP_SQE_UCODE_DBG_ADDR_DW),
+		    a | 0x10000u);
+		v0 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_DATA_DW));
+		gg_wr(gg.gpu, GR(CP_SQE_UCODE_DBG_ADDR_DW),
+		    (a + 1u) | 0x10000u);
+		v1 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_DATA_DW));
+		gg_wr(gg.gpu, GR(CP_SQE_UCODE_DBG_ADDR_DW),
+		    (a + 2u) | 0x10000u);
+		v2 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_DATA_DW));
+		gg_wr(gg.gpu, GR(CP_SQE_UCODE_DBG_ADDR_DW),
+		    (a + 3u) | 0x10000u);
+		v3 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_DATA_DW));
+		printf("GAUGUIN CP: 0281 ph%d dmem[%04x]=%08x %08x %08x"
+		    " %08x\n", ph, a, v0, v1, v2, v3);
+	}
+	(void)sweet_log_flush_now();
+	printf("GAUGUIN CP: 0281 ph%d dump done\n", ph);
+}
 
