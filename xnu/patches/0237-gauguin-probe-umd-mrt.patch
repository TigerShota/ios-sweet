 						    " nz0=%u ck1=%#x nz1=%u\n",
 						    CP_VA_SCRATCH + 0x1000u,
-						    CP_VA_SCRATCH + 0x2000u, gg_probe_ck0[0],
+						    tgt, gg_probe_ck0[0],
 						    nz0, gg_probe_ck0[1], nz1);
 					}
 				}
@@ -6692,8 +6702,8 @@
 						}
 					}
 				}
