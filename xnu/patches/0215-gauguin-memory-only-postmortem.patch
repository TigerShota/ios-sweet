+
+static int
+gg_regs_enabled(void)
+{
+	if (gg_regs_opt < 0) {
+		int v = 0;
+
+		gg_regs_opt = PE_parse_boot_argn("gauguinregs", &v, sizeof(v)) ?
+		    v : 0;
+	}
+	return gg_regs_opt;
+}
