 /*
+ * 0215: the sticky SMMU fault has been latched since before the first submit
+ * (`0214 smmu clear FAILED fsr=0x400 ack=0` at fence 0x6000002), and far=0 with
+ * it. Nothing so far says *when* it was recorded, so each bring-up stage that
+ * touches the GPU through the SMMU prints the record once: if fsr is already
+ * 0x400 at the first probe, the trigger is in GPU init and no later submit can
+ * be blamed.
+ */
+static void
+gg_smmu_probe(const char *tag)
+{
+	vm_offset_t s = gg_smmu_base();
+
+	if (s == 0) {
+		printf("GAUGUIN CP: 0215 smmu %s no base\n", tag);
+		return;
+	}
+	{
+		vm_offset_t cb = s + SMMU_CB(GG_CB1);
+
+		printf("GAUGUIN CP: 0215 smmu %s cb1 fsr=%#x far=%#x fsynr0=%#x"
+		    " gfsr=%#x sctlr=%#x\n", tag, gg_rd(cb, SMMU_CB_FSR),
+		    gg_rd(cb, SMMU_CB_FAR), gg_rd(cb, SMMU_CB_FSYNR0),
+		    gg_rd(s, SMMU_GFSR), gg_rd(cb, SMMU_CB_SCTLR));
+	}
+	(void)sweet_log_flush_now();
+}
