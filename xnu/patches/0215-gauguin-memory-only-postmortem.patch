+/*
+ * 0215: memory-only post-mortem. v165's wedge took out the whole register
+ * block (the first read, RBBM_STATUS, never returned and the watchdog reset the
+ * device), so nothing that follows a HUNG may touch MMIO. The ring window, the
+ * flattened copies and the GEM page tables are all in DRAM and still readable:
+ * print the submission's ring dwords, then for every annotated IB the packet
+ * the ME died in, the address fields it carried and a bounded scan of every
+ * dword that falls in the GPU VA range with its GEM translation.
+ */
+#define GG_MEM_VA_MAX 160u
+#define GG_MEM_PKT_MAX 48u
+
+static void
+gg_hung_mem(uint32_t fence, const uint64_t *ai, const uint32_t *wi,
+    uint32_t count, volatile uint32_t *ring, uint32_t ring_dw,
+    uint32_t start, uint32_t wp, uint64_t mark_mask)
+{
+	volatile uint32_t *rd = mark_rd ? (volatile uint32_t *)mark_rd :
+	    (volatile uint32_t *)mark_mem;
+	uint32_t k, o, n, va_seen = 0u, pkt_seen = 0u;
+
+	printf("GAUGUIN CP: 0215 mem fence=%#x ring=%u..%u size=%u\n", fence,
+	    start, wp, ring_dw);
+	for (o = start; o < wp && o < start + 48u; o++) {
+		printf("GAUGUIN CP: 0215 rr %u: %#x\n", o, ring[o % ring_dw]);
+	}
+	for (k = 0; k < count && k < GG_MARK_IBS; k++) {
+		volatile uint32_t *cp;
+		uint32_t stamp, pos;
+
+		if (rd == 0 || (mark_mask & (1ull << k)) == 0u || wi[k] == 0u) {
+			continue;
+		}
+		cp = rd + gg_mark_off[k] / 4u;
+		n = wi[k];
+		stamp = rd[GG_MARK_BASE / 4u + k];
+		pos = stamp & 0xffffu;
+		printf("GAUGUIN CP: 0215 ib=%u va=%#llx n=%u stamp=%#x exec=%u\n",
+		    k, (unsigned long long)ai[k], n, stamp, pos);
+		if (pos != 0u && pos < n) {
+			gg_pkt_decode("exec", cp, pos, n);
+		}
+		o = 0u;
+		while (o < n) {
+			uint32_t h = cp[o];
+			uint32_t type = h >> 28u;
+			uint32_t op = (h >> 16) & 0x7fu;
+			uint32_t plen, j;
+
+			if (type == 7u) {
+				plen = h & 0x3fffu;
+			} else if (type == 4u) {
+				plen = h & 0x7fu;
+			} else if (type == 0u) {
+				plen = ((h >> 16) & 0x3fffu) + 1u;
+			} else {
+				break;
+			}
+			if (o + 1u + plen > n) {
+				break;
+			}
+			if (type == 7u && (op == 0x38u || op == 0x45u ||
+			    op == 0x43u || op == 0x3fu) &&
+			    pkt_seen < GG_MEM_PKT_MAX) {
+				pkt_seen++;
+				printf("GAUGUIN CP: 0215 pkt ib=%u off=%u op=%#x"
+				    " n=%u", k, o, op, plen);
+				for (j = 0; j < plen && j < 10u; j++) {
+					printf(" %#x", cp[o + 1u + j]);
+				}
+				printf("\n");
+			}
+			for (j = 0; j < 1u + plen; j++) {
+				uint32_t v = cp[o + j];
+
+				if (v >= 0x40000000u && v < 0x80000000u &&
+				    va_seen < GG_MEM_VA_MAX) {
+					va_seen++;
+					printf("GAUGUIN CP: 0215 va ib=%u off=%u"
+					    " v=%#x gem=%d\n", k, o + j, v,
+					    gg_gem_pa(v) != 0u ? 1 : 0);
+				}
+			}
+			o += 1u + plen;
+		}
+	}
+	printf("GAUGUIN CP: 0215 mem done va=%u pkt=%u\n", va_seen, pkt_seen);
+	(void)sweet_log_flush_now();
+}
