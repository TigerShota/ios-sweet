+/* 0228: same move as gg_ins(), for a one-value type-7 packet (op 0x19). */
+static int
+gg_ins_pkt1(volatile uint32_t *out, uint32_t *np, uint32_t len, uint32_t op,
+    uint32_t val)
+{
+	uint32_t save[GG_INS_MAX], base, k;
+
+	if (len > GG_INS_MAX) {
+		return 0;
+	}
+	base = *np - len;
+	for (k = 0; k < len; ++k) {
+		save[k] = out[base + k];
+	}
+	*np = base;
+	out[(*np)++] = gg_pkt7(op, 1u);
+	out[(*np)++] = val;
+	for (k = 0; k < len; ++k) {
+		out[(*np)++] = save[k];
+	}
+	return 1;
+}
