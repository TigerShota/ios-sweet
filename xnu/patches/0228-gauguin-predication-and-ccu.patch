+/*
+ * 0228: v185/v187 leave every visible input correct - SP/FS ENABLED,
+ * STRIDE_IN_VPC 4, VPC dst 0, raster and target fine, RBBM idle right after the
+ * draw - and still nothing lands in RB_MRT0. Two silent-drop mechanisms remain,
+ * both cheap to test:
+ *  - draw predication: with CP_DRAW_PRED_ENABLE_GLOBAL on and a failing latched
+ *    predicate every draw retires without doing anything (gauguinnopred=1
+ *    inserts CP_DRAW_PRED_ENABLE_GLOBAL(0) in front of each started draw);
+ *  - the colour cache unit: RB_CCU_CNTL is the GMEM/sysmem offset the a6xx docs
+ *    call "important for sysmem path" (a618 sysmem = 0x10000 -> 0x08000000),
+ *    so gauguinccu=1 forces that value before each started draw.
+ */
+static int gg_nopred_opt = -2;
+static int gg_ccu_opt = -2;
+
+static int
+gg_nopred(void)
+{
+	if (gg_nopred_opt == -2) {
+		int v = 0;
+		int got = PE_parse_boot_argn("gauguinnopred", &v, sizeof(v));
+
+		gg_nopred_opt = got ? v : 0;
+		printf("GAUGUIN CP: 0228 nopred parse got=%d val=%d\n", got,
+		    gg_nopred_opt);
+	}
+	return gg_nopred_opt;
+}
+
+static int
+gg_ccu(void)
+{
+	if (gg_ccu_opt == -2) {
+		int v = 0;
+		int got = PE_parse_boot_argn("gauguinccu", &v, sizeof(v));
+
+		gg_ccu_opt = got ? v : 0;
+		printf("GAUGUIN CP: 0228 ccu parse got=%d val=%d\n", got,
+		    gg_ccu_opt);
+	}
+	return gg_ccu_opt;
+}
