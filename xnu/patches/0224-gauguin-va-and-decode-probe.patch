+/*
+ * 0224: with every descriptor now pointing at legal memory, the next thing that
+ * can stall a six-index draw is the attribute decode itself - the three
+ * VFD_DECODE entries all read fetch buffer 1, so zeroing DECODE_CNT
+ * (VFD_CONTROL_0 bits 13:8, FETCH_CNT stays 3) removes the attribute side while
+ * leaving the draw, the index fetch and the VS in place. Wedge gone = the
+ * decode/fetch path is the stall; wedge unchanged = the VS or the pipeline state
+ * handshake is.
+ */
+static int gg_nodecode_opt = -2;
+static int gg_nodecode_log;
+
+static int
+gg_nodecode(void)
+{
+	if (gg_nodecode_opt == -2) {
+		int v = 0;
+		int got = PE_parse_boot_argn("gauguinnodecode", &v, sizeof(v));
+
+		gg_nodecode_opt = got ? v : 0;
+		printf("GAUGUIN CP: 0224 nodecode parse got=%d val=%d\n", got,
+		    gg_nodecode_opt);
+	}
+	return gg_nodecode_opt;
+}
+
+/* 0224: dwords the rewrites may insert in front of one draw (see gg_ins). */
+static uint32_t
+gg_draw_extra(void)
+{
+	uint32_t n = 0u;
+
+	if (gg_fetchbind() > 0) {
+		n += 24u;
+	}
+	if (gg_nodecode() > 0) {
+		n += 2u;
+	}
+	return n;
+}
