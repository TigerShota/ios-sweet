 /*
+ * 0224: every descriptor now names a legal address, so dump what the address
+ * holds. A shader whose instructions were never uploaded, or a vertex buffer
+ * that is still all zeroes, stalls the 3D pipeline without any register looking
+ * wrong. gg_flat_rd() resolves through the GEM page cache and returns 0 for a
+ * page with no translation, so an unmapped buffer shows up as zeros plus pa=0.
+ */
+static void
+gg_va_dump(const char *tag, uint32_t va, uint32_t ndw)
+{
+	uint32_t i, k;
+
+	printf("GAUGUIN CP: 0224 va %s addr=%#x pa=%#x\n", tag, va,
+	    (uint32_t)gg_gem_pa(va));
+	for (i = 0; i < ndw; i += 4u) {
+		printf("GAUGUIN CP: 0224 dw %s +%#x:", tag, 4u * i);
+		for (k = 0; k < 4u && i + k < ndw; k++) {
+			printf(" %08x", gg_flat_rd(va, i + k));
+		}
+		printf("\n");
+	}
+}
