+/*
+ * 0224: the indices the draw will actually read, plus the worst-case vertex
+ * address they produce (VFD_FETCH[1].BASE + index * STRIDE). If that address
+ * leaves the fetch buffer's allocation or has no translation, the VFD waits for
+ * a read that never completes - and the draw is only six indices, so a single
+ * bad index is enough.
+ */
+static void
+gg_idx_data(uint32_t fence, uint32_t base, uint32_t first, uint32_t num)
+{
+	uint32_t i, v, mx = 0u, fb, stride, flo = 0u, fhi = 0u;
+	uint64_t ea;
+
+	/* draw0.INDEX_SIZE reads 1 (16-bit) in every capture */
+	printf("GAUGUIN CP: 0224 idx fence=%#x base=%#x first=%u n=%u:",
+	    fence, base, first, num);
+	for (i = 0u; i < num && i < 256u; i++) {
+		uint32_t w = gg_flat_rd(base, (first + i) / 2u);
+
+		v = ((first + i) & 1u) != 0u ? (w >> 16) : (w & 0xffffu);
+		if (v > mx) {
+			mx = v;
+		}
+		if (i < 8u) {
+			printf(" %u", v);
+		}
+	}
+	printf("\n");
+	fb = gg_rd(gg.gpu, GR(0xa014u));	/* VFD_FETCH[1].BASE_LO */
+	stride = gg_rd(gg.gpu, GR(0xa017u));	/* VFD_FETCH[1].STRIDE */
+	gg_obj_span(fb, &flo, &fhi);
+	ea = (uint64_t)fb + (uint64_t)mx * (uint64_t)stride;
+	printf("GAUGUIN CP: 0224 vtx max_idx=%u fetch1=%#x stride=%u ea=%#llx"
+	    " gem=%u span=%#x..%#x%s\n", mx, fb, stride,
+	    (unsigned long long)ea, gg_gem_pa(ea) != 0u ? 1u : 0u, flo, fhi,
+	    (ea < (uint64_t)flo || (fhi != 0u && ea >= (uint64_t)fhi)) ?
+	    " OUTSIDE" : "");
+}
