-		    gg_fetchbind() > 0 ? 24u : 0u) > max) {
+		/* 0223/0224: reserve room for the writes inserted in front of a
+		 * draw (vertex fetch binds, attribute-decode count). */
+		if (*np + len + 5u + (type == 7u && op == 0x38u ?
