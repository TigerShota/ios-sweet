+
+/*
+ * 0148: read a GPU-side IB back through its GEM page table entry, the same
+ * translation gg_gem_pa() does for the 0146 timestamp dump. Every IB the
+ * window server builds is page aligned and smaller than a page, so one
+ * mapping covers it; the caller checks the fast path instead of us walking
+ * a second page.
+ */
+static void
+gg_ib_dwords(const char *tag, uint64_t iova, uint32_t dwords, uint32_t at)
+{
+	uint64_t pa;
+	vm_offset_t m;
+	uint32_t k, lo, n;
+
+	if (dwords == 0u ||
+	    (iova & 0xfffu) + 4u * (uint64_t)dwords > GEM_PAGE) {
+		return;
+	}
+	pa = gg_gem_pa(iova);
+	if (pa == 0u) {
+		printf("GAUGUIN CP: %s ib %#llx not in the GEM window\n", tag,
+		    (unsigned long long)iova);
+		return;
+	}
+	m = ml_io_map((vm_offset_t)(pa & ~0xfffull), GEM_PAGE);
+	if (m == 0) {
+		return;
+	}
+	m += (vm_offset_t)(iova & 0xfffu);
+	n = dwords < 8u ? dwords : 8u;
+	printf("GAUGUIN CP: %s ib %#llx/%u head:", tag,
+	    (unsigned long long)iova, dwords);
+	for (k = 0; k < n; k++) {
+		printf(" %#x", gg_rd(m, 4u * k));
+	}
+	printf("\n");
+	if (at == 0u) {
+		return;
+	}
+	lo = at > 4u ? at - 4u : 0u;
+	n = dwords - lo < 12u ? dwords - lo : 12u;
+	printf("GAUGUIN CP: %s ib %#llx at %u:", tag,
+	    (unsigned long long)iova, at);
+	for (k = 0; k < n; k++) {
+		printf(" %#x", gg_rd(m, 4u * (lo + k)));
+	}
+	printf("\n");
 }
 
