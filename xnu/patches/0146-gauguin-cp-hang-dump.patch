+/*
+ * 0146: translate a GEM IOVA into the physical page its data lives in, so
+ * the hang dump can read back a timestamp the CP was supposed to write.
+ */
+static uint64_t
+gg_gem_pa(uint64_t iova)
+{
+	uint32_t tbl;
+	uint64_t e;
+
+	if (!gg_gem_l2(iova, &tbl)) {
+		return 0u;
+	}
+	e = *(volatile uint64_t *)(gem_l3 + 0x1000u * tbl +
+	    8u * ((iova >> 12) & 0x1ffu));
+	if ((e & 3u) == 0u) {
+		return 0u;
+	}
+	return e & 0x0000fffffffff000ULL;
+}
