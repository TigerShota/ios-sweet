diff --git a/bsd/dev/gauguin_gpu.c b/bsd/dev/gauguin_gpu.c
--- a/bsd/dev/gauguin_gpu.c
+++ b/bsd/dev/gauguin_gpu.c
@@ -1595,10 +1595,17 @@
 /* PM4 type-4 header: one dword written to a 3D/2D core register. Same bit
  * layout as the reference's ring_register(). */
 static uint32_t
 gg_pkt4(uint32_t number)
 {
 	return (4u << 28) | 1u | (gg_parity(1u) << 7) |
-	    ((number & 0x3fffu) << 8) | (gg_parity(number) << 27);
+	    /*
+	     * The type-4 base index is 18 bits (0x3FFFF), not 14. The 2D
+	     * registers sit at 0x84xx/0x8cxx, so the old 0x3FFF mask encoded
+	     * 0x8c18 as 0x0c18 while the parity bit still covered 0x8c18:
+	     * every type-4 header failed parity and the CP raised
+	     * CP_OPCODE_ERROR (CP_INTERRUPT_STATUS bit 0).
+	     */
+	    ((number & 0x3ffffu) << 8) | (gg_parity(number) << 27);
 }
 
