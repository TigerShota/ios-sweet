diff --git a/bsd/dev/gauguin_gpu.c b/bsd/dev/gauguin_gpu.c
--- a/bsd/dev/gauguin_gpu.c
+++ b/bsd/dev/gauguin_gpu.c
@@ -1592,13 +1592,21 @@
 	    ((opcode & 0x7fu) << 16) | (gg_parity(opcode) << 23);
 }
 
+/* 18-bit register number for CP_TYPE4_PKT: 0x4 << 16 | SUBBLOCK_OFFSET.
+ * a6xx mainline (cp_register) passes this to cp_type4_packet; passing the
+ * raw 16-bit hardware register address produces wrong encodings and makes
+ * the CP raise CP_OPCODE_ERROR (RBBM_INT_0_STATUS bit 0). */
+#define GG_CP_REG(reg) ((0x4u << 16) | (((unsigned int)(reg)) - 0x2000u))
+
 /* PM4 type-4 header: one dword written to a 3D/2D core register. Same bit
  * layout as the reference's ring_register(). */
 static uint32_t
 gg_pkt4(uint32_t number)
 {
+	uint32_t opcode = GG_CP_REG(number);
+
 	return (4u << 28) | 1u | (gg_parity(1u) << 7) |
-	    ((number & 0x3fffu) << 8) | (gg_parity(number) << 27);
+	    ((opcode & 0x3ffffu) << 8) | (gg_parity(opcode) << 27);
 }
 
