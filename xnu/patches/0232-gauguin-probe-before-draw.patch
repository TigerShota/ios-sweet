 	};
 	uint32_t need = 2u * (sizeof(st) / 4u) + 20u;
-	uint32_t i;
-
-	if (*np + need > max) {
-		return 0;
+	uint32_t i, n = 0u;
+
+	if (need > max) {
+		return 0u;
 	}
 	for (i = 0u; i < sizeof(st) / 4u; i += 2u) {
-		out[(*np)++] = gg_pkt4(st[i]);
-		out[(*np)++] = st[i + 1u];
+		out[n++] = gg_pkt4(st[i]);
+		out[n++] = st[i + 1u];
 	}
 	/* top half: pixel-space triangle */
-	out[(*np)++] = gg_pkt4(0x8825u);
-	out[(*np)++] = tgt;
-	out[(*np)++] = gg_pkt4(0xa014u);
-	out[(*np)++] = vb;
-	out[(*np)++] = gg_pkt7(0x38u, 3u);
-	out[(*np)++] = 0x104u;		/* DI_PT_TRILIST, VIS_CULL 1 */
-	out[(*np)++] = 1u;		/* instances */
-	out[(*np)++] = 3u;		/* vertices */
+	out[n++] = gg_pkt4(0x8825u);
+	out[n++] = tgt;
+	out[n++] = gg_pkt4(0xa014u);
+	out[n++] = vb;
+	out[n++] = gg_pkt7(0x38u, 3u);
+	out[n++] = 0x104u;		/* DI_PT_TRILIST, VIS_CULL 1 */
+	out[n++] = 1u;			/* instances */
+	out[n++] = 3u;			/* vertices */
 	/* bottom half: NDC triangle */
-	out[(*np)++] = gg_pkt4(0x8825u);
-	out[(*np)++] = tgt + TARGET_PITCH * 128u;
-	out[(*np)++] = gg_pkt4(0xa014u);
-	out[(*np)++] = vb + 3u * 0x30u;
-	out[(*np)++] = gg_pkt7(0x38u, 3u);
-	out[(*np)++] = 0x104u;
-	out[(*np)++] = 1u;
-	out[(*np)++] = 3u;
-	return 1;
+	out[n++] = gg_pkt4(0x8825u);
+	out[n++] = tgt + TARGET_PITCH * 128u;
+	out[n++] = gg_pkt4(0xa014u);
+	out[n++] = vb + 3u * 0x30u;
+	out[n++] = gg_pkt7(0x38u, 3u);
+	out[n++] = 0x104u;
+	out[n++] = 1u;
+	out[n++] = 3u;
+	return n;
 }
 
 /* 0224: dwords the rewrites may insert in front of one draw (see gg_ins). */
@@ -3904,6 +3933,10 @@
 	}
 	if (gg_ccu() > 0) {
 		n += 2u;
+	}
+	/* 0232: the probe is inserted in front of one draw. */
+	if (gg_probe3d() > 0 && gg_probe_state == 0) {
+		n += 140u;
 	}
 	return n;
 }
