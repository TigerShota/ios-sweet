-/* Append the probe's state block and its two draws; false if it does not fit. */
+/* 0232: same move-the-packet trick as gg_ins, for a payload we built. */
 static int
-gg_probe_emit(volatile uint32_t *out, uint32_t *np, uint32_t max, uint32_t tgt,
-    uint32_t vb)
+gg_ins_raw(volatile uint32_t *out, uint32_t *np, uint32_t len, const uint32_t *pay,
+    uint32_t n)
+{
+	uint32_t save[GG_INS_MAX], base, k;
+
+	if (len > GG_INS_MAX) {
+		return 0;
+	}
+	base = *np - len;
+	for (k = 0; k < len; ++k) {
+		save[k] = out[base + k];
+	}
+	*np = base;
+	for (k = 0; k < n; ++k) {
+		out[(*np)++] = pay[k];
+	}
+	for (k = 0; k < len; ++k) {
+		out[(*np)++] = save[k];
+	}
+	return 1;
+}
+
+/*
+ * 0232: build the probe into a buffer so it can be inserted *in front of* the
+ * UMD's draw. Appended behind it (0229) the probe only ran when that draw
+ * completed, and the draw is exactly what stalls the ME. Returns 0 when it would
+ * not fit. Note the probe is only armed for the first started draw of the boot,
+ * so the copy path (and therefore 0215/0222/0223) stays the annotated one.
+ */
+static uint32_t
+gg_probe_emit(uint32_t *out, uint32_t max, uint32_t tgt, uint32_t vb)
 {
 	static const uint32_t st[] = {
 		0x8820u, 0x7e0u,	/* RB_MRT0_CONTROL: copy, comp mask 0xf */
@@ -3851,34 +3880,34 @@
