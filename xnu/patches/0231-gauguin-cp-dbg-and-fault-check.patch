+/*
+ * 0231: two read-only questions left. (a) Did the 0229 probe's own memory
+ * accesses fault? The probe read vertices and wrote its target through VAs that
+ * only the CP's page tables are known to cover, so an SMMU `far` naming one of
+ * them would void that experiment and move the probe into GEM memory. (b) Where
+ * does the front end sit when a draw never completes - ROQ occupancy, SQE status
+ * and the interrupt/protect latches separate "the ME is waiting on the pipeline"
+ * from "the ME never dispatched the draw".
+ */
+static void
+gg_cp_dbg(const char *tag)
+{
+	printf("GAUGUIN CP: 0231 cp %s st=%#x st1=%#x intr=%#x prot=%#x"
+	    " roq=%#x avail=%#x sqe=%#x/%#x rbbm=%#x clk=%#x\n", tag,
+	    gg_rd(gg.gpu, GR(CP_SQE_CNTL_DW)),
+	    gg_rd(gg.gpu, GR(CP_STATUS_1_DW)),
+	    gg_rd(gg.gpu, GR(CP_INTERRUPT_STATUS_DW)),
+	    gg_rd(gg.gpu, GR(CP_PROTECT_STATUS_DW)),
+	    gg_rd(gg.gpu, GR(CP_ROQ_RB_STAT_DW)),
+	    gg_rd(gg.gpu, GR(CP_ROQ_AVAIL_RB_DW)),
+	    gg_rd(gg.gpu, GR(CP_SQE_STAT_ADDR_DW)),
+	    gg_rd(gg.gpu, GR(CP_SQE_STAT_DATA_DW)),
+	    gg_rd(gg.gpu, GR(0x0210u)),
+	    gg_rd(gg.gpu, GR(0x00aeu)));
 	(void)sweet_log_flush_now();
 }
 
