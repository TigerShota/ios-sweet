 /*
+ * 0263: a splice can push the grown IB past the 4 KiB page it started in, and
+ * 0194 already walks multi-page IBs dword by dword, so the old
+ * "must still fit in one page" test rejected whole submissions that a v224
+ * log shows are perfectly serviceable (0x56166000 spans 3 pages). Probe one
+ * dword per destination page instead of one flat limit.
+ */
+static int
+gg_flat_map_ok(uint64_t iova, uint32_t from, uint32_t to)
+{
+	uint64_t a = iova + 4u * (uint64_t)from;
+	uint64_t z = iova + 4u * (uint64_t)to;
+
+	while (a < z) {
+		uint64_t next = (a | 0xfffu) + 1u;
+
+		if (gg_san_map(a) == 0u) {
+			return 0;
+		}
+		a = (next < z) ? next : z;
+	}
+	return 1;
+}
