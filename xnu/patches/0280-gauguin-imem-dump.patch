From: Trae <trae@local>
Subject: [PATCH] 0280: gauguin - dump SQE IMEM + probe DMEM at
 the first hang

v240 verdict: swapping every CP_BLIT hdr for a count-1 CP_NOP
left the hang printout bit-identical (sqe_pc 0x4:0x2883003f,
status1 0x810077de) - executing the blit is irrelevant.  The
"PC" pair is now explained: the pre-state diag writes
DBG_ADDR/STAT_ADDR 0..3 and each DATA read auto-increments the
port, so every HUNG printout replays ADDR=4
DATA=IMEM[4]=0x2883003f (a630_sqe.fw word 261, i.e. IMEM[4]
under a 257-dword fw header) - a static readback, not a PC.
The hang never had an observed PC.  0280 dumps the whole SQE
IMEM (8192 dwords) once at the first hang via per-word ADDR
writes + DATA reads (correct with or without auto-increment),
then probes the DMEM select bit 16 for 1024 dwords.  Local
compare against a630_sqe.fw establishes the DBG_ADDR -> fw
word mapping and verifies what the ME actually loaded.
Boot arg: gauguinimem=1 (flatnop/flatbr/nop dropped from the
cmdline - original stream again; budget 567 <= 607).
---
diff --git a/bsd/dev/gauguin_gpu.c b/bsd/dev/gauguin_gpu.c
index b524861..e987b22 100644
--- a/bsd/dev/gauguin_gpu.c
+++ b/bsd/dev/gauguin_gpu.c
@@ -3415,6 +3415,8 @@ static int gg_state_log;
 static int gg_hung_log;
 static int gg_ib_dump_log;
 static int gg_wrap_log;
+static int gg_imem_opt = -2;	/* 0280: -2 unparsed, -1 off, >=0 on */
+static int gg_imem_done;
 
 /*
  * 0142: the CP stops retiring fences after v96's first frames (rptr==wptr,
@@ -5874,6 +5876,16 @@ gg_ib_sanitize(uint64_t iova, uint32_t dwords, int depth)
 				    gg_nop_opt);
 			}
 		}
+		if (gg_imem_opt == -2) {
+			int v = 0;
+
+			gg_imem_opt = PE_parse_boot_argn("gauguinimem",
+			    &v, sizeof(v)) ? v : -1;
+			if (gg_imem_opt >= 0) {
+				printf("GAUGUIN CP: 0280 imem val=%d armed\n",
+				    gg_imem_opt);
+			}
+		}
 		for (k = gg_splice_n; k-- > 0u; ) {
 			uint32_t so = gg_splice[k].o;
 			uint32_t tn = gg_splice[k].n;
@@ -9672,6 +9684,60 @@ gauguin_cp_submit(const uint64_t * addresses, const uint32_t * words, uint32_t c
 	    gg_rd(gg.gpucc, GPUCC_GFX3D_CBCR), gg_rd(gg.gpucc, GPUCC_GFX3D_SRC),
 	    gg_rd(gg.gpucc, GPUCC_GMU_CBCR));
 	gg_rbbm_busy();
+	/*
+	 * 0280: the hang-printout "PC" pair is a static readback, not a
+	 * PC: the pre-state diag writes CP_SQE_UCODE_DBG_ADDR and
+	 * CP_SQE_STAT_ADDR 0..3 and each DATA read auto-increments the
+	 * port, so every HUNG printout replays ADDR=4 DATA=IMEM[4] /
+	 * bank[4] - bit-identical across v237/v239/v240 AND v131-133
+	 * (0x4:0x2883003f).  Dump the whole SQE IMEM once at the first
+	 * hang, then probe the DMEM select (bit 16); per-word ADDR write
+	 * + DATA read is correct whether or not the port auto-increments.
+	 */
+	if (gg_imem_opt >= 0 && gg_imem_done == 0) {
+		uint32_t a, v0, v1, v2, v3;
+
+		gg_imem_done = 1;
+		v0 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_ADDR_DW));
+		v1 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_DATA_DW));
+		v2 = gg_rd(gg.gpu, GR(CP_SQE_STAT_ADDR_DW));
+		v3 = gg_rd(gg.gpu, GR(CP_SQE_STAT_DATA_DW));
+		printf("GAUGUIN CP: 0280 readback ucode=%#x:%#x"
+		    " stat=%#x:%#x\n", v0, v1, v2, v3);
+		(void)sweet_log_flush_now();
+		for (a = 0u; a < 8192u; a += 4u) {
+			gg_wr(gg.gpu, GR(CP_SQE_UCODE_DBG_ADDR_DW), a);
+			v0 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_DATA_DW));
+			gg_wr(gg.gpu, GR(CP_SQE_UCODE_DBG_ADDR_DW), a + 1u);
+			v1 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_DATA_DW));
+			gg_wr(gg.gpu, GR(CP_SQE_UCODE_DBG_ADDR_DW), a + 2u);
+			v2 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_DATA_DW));
+			gg_wr(gg.gpu, GR(CP_SQE_UCODE_DBG_ADDR_DW), a + 3u);
+			v3 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_DATA_DW));
+			printf("GAUGUIN CP: 0280 imem[%04x]=%08x %08x %08x"
+			    " %08x\n", a, v0, v1, v2, v3);
+		}
+		(void)sweet_log_flush_now();
+		for (a = 0u; a < 1024u; a += 4u) {
+			gg_wr(gg.gpu, GR(CP_SQE_UCODE_DBG_ADDR_DW),
+			    a | 0x10000u);
+			v0 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_DATA_DW));
+			gg_wr(gg.gpu, GR(CP_SQE_UCODE_DBG_ADDR_DW),
+			    (a + 1u) | 0x10000u);
+			v1 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_DATA_DW));
+			gg_wr(gg.gpu, GR(CP_SQE_UCODE_DBG_ADDR_DW),
+			    (a + 2u) | 0x10000u);
+			v2 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_DATA_DW));
+			gg_wr(gg.gpu, GR(CP_SQE_UCODE_DBG_ADDR_DW),
+			    (a + 3u) | 0x10000u);
+			v3 = gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_DATA_DW));
+			printf("GAUGUIN CP: 0280 dmem[%04x]=%08x %08x %08x"
+			    " %08x\n", a, v0, v1, v2, v3);
+		}
+		(void)sweet_log_flush_now();
+		printf("GAUGUIN CP: 0280 imem dump done\n");
+	}
+	gg_rbbm_busy();
 	if (gg_ib_dump_log < 2) {
 		uint32_t stuck = gg_rd(gg.gpu, GR(CP_IB1_BASE_DW));
 		uint32_t rem = gg_rd(gg.gpu, GR(CP_IB1_REM_SIZE_DW));

