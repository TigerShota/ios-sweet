diff --git a/bsd/dev/gauguin_gpu.c b/bsd/dev/gauguin_gpu.c
index 8002cfb..9837e24 100644
--- a/bsd/dev/gauguin_gpu.c
+++ b/bsd/dev/gauguin_gpu.c
@@ -4396,6 +4396,12 @@ gauguin_gem_map(uint64_t iova, addr64_t phys, uint32_t flags)
 	}
 	pte = (uint32_t)((iova >> 12) & 0x1ffu);
 	gg_gem_wr(0x1000u * tbl + 8u * pte, ((uint64_t)phys & ~0xfffull) | PTE_PAGE_NC);
+	/* 0170 (fajita 0166 #1): flush the GPU TLB after every PTE write so a
+	 * freshly mapped (possibly iova-reused) buffer is visible to the CP
+	 * before it walks the table; without this the CP keeps fetching the
+	 * stale indirect buffer and hangs on CP_INDIRECT_BUFFER. The global
+	 * non-secure TLB invalidation lives in gauguin_gem_tlb_flush() (0125). */
+	gauguin_gem_tlb_flush();
 	return true;
 }
 
