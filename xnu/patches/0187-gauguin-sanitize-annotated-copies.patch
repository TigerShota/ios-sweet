+/*
+ * 0187: read the packet at original offset "at" from the annotated copy.
+ * The copy is the raw stream plus a fixed 5-dword stamp after every packet,
+ * and sanitize is length-preserving, so walking it by packet length maps
+ * source offsets to copy offsets. Returns the bytes the ME actually fetched
+ * after sanitization, which is what the stamp names.
+ */
+static void
+gg_mark_read(uint32_t index, uint32_t at, uint32_t out[4])
+{
+	volatile uint32_t *p;
+	uint32_t n, o = 0u, pos = 0u, k;
+
+	out[0] = out[1] = out[2] = out[3] = 0u;
+	if (index >= GG_MARK_IBS || mark_mem == 0) {
+		return;
+	}
+	p = (volatile uint32_t *)((mark_rd ? mark_rd : mark_mem) +
+	    gg_mark_off[index]);
+	n = gg_mark_len[index];
+	while (pos < n) {
+		uint32_t h = p[pos];
+		uint32_t type = h >> 28;
+		uint32_t plen, len;
+
+		if (type == 7u) {
+			plen = h & 0x3fffu;
+		} else if (type == 4u) {
+			plen = h & 0x7fu;
+		} else if (type == 0u) {
+			plen = ((h >> 16) & 0x3fffu) + 1u;
+		} else {
+			break;
+		}
+		len = 1u + plen;
+		if (pos + len > n) {
+			break;
+		}
+		if (o == at) {
+			for (k = 0; k < 4u && pos + k < n; k++) {
+				out[k] = p[pos + k];
+			}
+			return;
+		}
+		o += len;
+		pos += len;
+		if (pos + 5u <= n) {
+			pos += 5u;	/* the annotation stamp */
+		}
+	}
 }
 
