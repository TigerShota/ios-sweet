+			ring[n++] = gg_pkt4(RB_2D_SRC_SOLID_C0 + 2u);
+			ring[n++] = band[k][2];
+			ring[n++] = gg_pkt4(RB_2D_SRC_SOLID_C0 + 3u);
+			ring[n++] = 255u;
+			ring[n++] = gg_pkt4(RB_2D_BLIT_CNTL);
+			ring[n++] = BLIT_SOLID_8888;
+			ring[n++] = gg_pkt4(GRAS_2D_BLIT_CNTL);
+			ring[n++] = BLIT_SOLID_8888;
