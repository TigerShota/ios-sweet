+	{
+		uint32_t n = 17u, k;
+		const uint32_t band[3][3] = {
+			{ 255u, 128u, 0u },     /* orange */
+			{ 255u, 255u, 255u },   /* white */
+			{ 0u, 128u, 255u },     /* blue */
+		};
