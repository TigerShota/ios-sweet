 OSDefineMetaClassAndStructors(IOMobileFramebufferUserClient, IOUserClient);
 
+/*
+ * Tiny IOAcceleratorES stub so CoreAnimation / backboardd's
+ * IOServiceMatching("IOAcceleratorES") finds *something*. Metal sees no
+ * MetalPluginName and falls through to the CPU software renderer — but at
+ * least the matching loop stops (otherwise backboardd polls 30 s + 300 times
+ * before giving up and the whole UI freezes on a dead black screen).
+ * sweetaccel=0 disables the stub for debugging.
+ */
+class IOAcceleratorES : public IOService {
+	OSDeclareDefaultStructors(IOAcceleratorES);
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+
+bool
+IOAcceleratorES::start(IOService *provider)
+{
+	return IOService::start(provider);
+}
+
+
+
 bool
 AppleCLCD::start(IOService *provider)
 {
@@ -201,6 +224,31 @@
 	setProperty("external", false);
 	setProperty("DisplayPipePlaneBaseAlignment", 64ULL, 32);
 	registerService();
+	/* Publish IOAcceleratorES stub for CoreAnimation. */
+	int accel = 1;
+	PE_parse_boot_argn("sweetaccel", &accel, sizeof(accel));
+	if (accel) {
+		IOAcceleratorES *stub = new IOAcceleratorES;
+		if (stub != NULL && stub->init()) {
+			stub->attach(this);
+			if (stub->start(this)) {
+				stub->registerService();
+				IOLog("SWEET FB: IOAcceleratorES published (class only, no MetalPluginName)
+");
+			} else {
+				IOLog("SWEET FB: IOAcceleratorES start failed
+");
+				OSSafeReleaseNULL(stub);
+			}
+		} else {
+			IOLog("SWEET FB: IOAcceleratorES alloc/init failed
+");
+			OSSafeReleaseNULL(stub);
+		}
+	} else {
+		IOLog("SWEET FB: IOAcceleratorES disabled (sweetaccel=0)
+");
+	}
 	IOLog("SWEET FB: AppleCLCD %ux%u stride %u at 0x%llx, default surface %u, presented as %ux%u\n",
 	    fWidth, fHeight, fRowBytes, fPhys, fSurface->id, fLogicalW, fLogicalH);
 	return true;
