-			uint32_t type = h >> 28;
-			uint32_t op, cnt, adv;
-
-			if (type == 7u) {
-				op = (h >> 16) & 0x7fu;
-				cnt = h & 0x3fffu;
-				adv = cnt + 1u;
-			} else if (type == 4u) {
-				op = 0x1000u + ((h >> 8) & 0x3ffffu);
-				adv = 2u + ((h >> 16) & 3u);
-				cnt = adv;
