-			a += adv;
-		}
-		(void)sweet_log_flush_now();
+		uint32_t r = gg_rd(gg.gpu, GR(CP_IB1_REM_SIZE_DW));
+
+		if (b != 0u && r != 0u && b == gg_last_ib &&
