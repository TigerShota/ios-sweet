+			uint32_t r2, start, a, k, n;
+
+			gg_walk_n++;
+			delay(200);
+			r2 = gg_rd(gg.gpu, GR(CP_IB1_REM_SIZE_DW));
+			start = b;
+			if (gg_san_va == b && gg_san_dw > r) {
