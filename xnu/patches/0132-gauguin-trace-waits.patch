diff --git a/iokit/Kernel/arm/SweetAdreno.cpp b/iokit/Kernel/arm/SweetAdreno.cpp
--- a/iokit/Kernel/arm/SweetAdreno.cpp
+++ b/iokit/Kernel/arm/SweetAdreno.cpp
@@ -224,7 +224,7 @@ static IOLock * gGPULock;
 static uint32_t gGPUReportedSubmits;
 static uint32_t gGPUTraceCalls;   /* 0131: first N driver calls are logged */
 
-#define GPU_TRACE_LIMIT 200u
+#define GPU_TRACE_LIMIT 2000u
 
 /* ---- gpu_buffer ---- */
 
@@ -963,6 +963,11 @@ SweetAdrenoUserClient::externalMethod(uint32_t selector, IOExternalMethodArgumen
 		patience_ns = (r.cpuPrep.op & MSM_PREP_NOSYNC) ? 0 :
