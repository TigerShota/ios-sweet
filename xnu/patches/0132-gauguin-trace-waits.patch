@@ -982,6 +987,11 @@ SweetAdrenoUserClient::externalMethod(uint32_t selector, IOExternalMethodArgumen
 	case kMsmWaitFence:
 		patience_ns = r.waitFence.timeout.tv_sec * NSEC_PER_SEC +
 		    r.waitFence.timeout.tv_nsec;
+		if (gGPUTraceCalls < GPU_TRACE_LIMIT) {
+			gGPUTraceCalls++;
+			IOLog("SweetAdreno: trace wait_fence f=%u ns=%llu\n",
