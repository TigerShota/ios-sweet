+/*
+ * 0206: stop the RAM ring from wrapping once the interesting event has been
+ * logged. v152/v154 lost the whole first-wedge dump because every later retry
+ * prints a ~60-line Mesa/BO block and 1700 of them wrap 4 MiB within seconds.
+ * After the freeze the ring keeps the last 4 MiB, i.e. exactly the dump, and
+ * the periodic flusher still pushes it out.
+ */
+static volatile int sweet_log_frozen;
+
+void
+sweet_log_freeze(void)
+{
+	sweet_log_frozen = 1;
+}
+
 /* Called for all console output, any context: never blocks. */
