+/* Map every physical run of a descriptor into the GEM window, 4 KiB at a time. */
+static IOReturn
+map_bo_pages(uint64_t iova, IOMemoryDescriptor * memory, uint64_t size,
+    uint32_t flags)
+{
+	IOByteCount off = 0;
+
+	while (off < size) {
+		IOByteCount len = 0;
+		addr64_t pa = memory->getPhysicalSegment(off, &len,
+		    kIOMemoryMapperNone);
+
+		if (pa == 0 || len == 0) {
+			gauguin_gem_unmap(iova, size);
+			return kIOReturnNoMemory;
+		}
+		for (IOByteCount p = 0; p + 0x1000 <= len; p += 0x1000) {
+			if (!gauguin_gem_map(iova + off + p, pa + p, flags)) {
+				gauguin_gem_unmap(iova, size);
+				return kIOReturnNoMemory;
+			}
+		}
+		off += len;
+	}
+	gauguin_gem_tlb_flush();
+	return kIOReturnSuccess;
+}
