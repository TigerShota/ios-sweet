 static uint32_t gg_last_ib, gg_last_rem;
 /*
+ * 0256: the length of every IB the sanitizer has seen, keyed by address. The
+ * "last sanitized IB" global was overwritten by later submissions, which is why
+ * the stop offset could not be computed in v196, and IB2 needs its own entry.
+ */
+#define GG_IB_MAP 16
+static struct gg_ibw_s {
+	uint32_t va;
+	uint32_t dw;
+} gg_ibw[GG_IB_MAP];
+static uint32_t gg_ibw_n;
+
+static void
+gg_ibw_note(uint32_t va, uint32_t dw)
+{
+	uint32_t i;
+
+	if (va == 0u || dw == 0u) {
+		return;
+	}
+	for (i = 0u; i < GG_IB_MAP; i++) {
+		if (gg_ibw[i].va == va) {
+			gg_ibw[i].dw = dw;
+			return;
+		}
+	}
+	gg_ibw[gg_ibw_n % GG_IB_MAP].va = va;
+	gg_ibw[gg_ibw_n % GG_IB_MAP].dw = dw;
+	gg_ibw_n++;
+}
+
+static uint32_t
+gg_ibw_len(uint32_t va)
+{
+	uint32_t i;
+
+	for (i = 0u; i < GG_IB_MAP; i++) {
+		if (gg_ibw[i].va == va) {
+			return gg_ibw[i].dw;
+		}
+	}
+	return 0u;
+}
