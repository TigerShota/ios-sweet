+/*
+ * gauguin (SM6350/lagoon) touch bring-up: Novatek NT36672A on GENI SE0 SPI.
+ * Zero-firmware first light: HW reset, then the IC boots its own flash
+ * firmware; the event buffer is polled and fed to sweet_hid_touch().
+ * All facts from the vendor tree (gauguin-sm6350.dtsi, pinctrl-lagoon.c,
+ * gcc-lagoon.c, geni-se.h, nt36xxx.c): SE0 0x880000 with CS gpio3 and
+ * SCK/MISO/MOSI gpio0/1/2 (qup00: gpio0/1 mux 2, gpio2/3 mux 1), reset
+ * tlmm 21 (active low), irq tlmm 22; GCC votes 0x52000 bits 6/7/10, SE0
+ * RCG 0x21148 (parent 0 = XO 19.2 MHz); SPI FIFO opcodes TX=1 RX=2
+ * DUPLEX=3 packed into M_CMD0 << 27. SCK = 19.2M/(2*2) = 4.8 MHz.
+ * v7: packing CFG1 0x000FFEFE (v6 typo'd F/E -> garbled unpack, the
+ * sweetlog24/25 stall) and the Linux transfer order: M_CMD first, then
+ * TX_WATERMARK=1 arms the FIFO pump; data is pushed on TX_READY.
+ * v8: trim page fix (v7 double-shifted the address: page 0x1F600 instead
+ * of 0x3EC -> blank xdata -> all-FF id) + vendor probe key (eng reset
+ * 0x5A->0x7FFF80 sent while TP_RESX is LOW) + 5x trim retries + frame dump.
+ * v10: the IC is NT36675 (trim id 0x0C/xx/xx/72/66/03 - vendor trim table
+ * row 1), NOT NT36672A: EVENT_BUF is 0x22D00 (v9 polled the NT36672A page
+ * 0x21C00 - wrong address all along), hw_crc=2 (CRC-bank LENGTH is 4 bytes)
+ * and DMA_CRC_EN is 0x3F136. Firmware = novatek_ts_fw01/02.bin (NT36675
+ * panel variants, from the LineageOS gauguin kernel firmware/ dir, ihex
+ * -> bin), embedded as C arrays; host download per vendor
+ * nvt_download_firmware_hw_crc. Boot-arg gauguintouchfw=1/2 (default 1).
+ * Boot-args: gauguintouch=0/1 (default on), gauguintouchdelay=<seconds>.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <string.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+/* Mach MIG declaration is not included by BSD's exported thread.h. */
+extern kern_return_t thread_terminate(thread_t);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void gauguin_touch_init(void);
+/* NT36675 panel firmwares (generated from the LineageOS gauguin kernel
+ * firmware/ ihex blobs; see bsd/dev/gauguin_touch_fw.h). */
+extern const uint8_t nvt_fw01[], nvt_fw02[];
+extern const unsigned nvt_fw01_len, nvt_fw02_len;
+
+#define GT_SE_PA       0x00880000u
+#define GT_GCC_PA      0x00100000u
+#define GT_TLMM_PA     0x0f100000u
+
+/* GCC lagoon: qupv3 wrapper0 AHB + SE0 branch votes and the SE0 RCG. */
+#define GT_VOTE        0x52000u
+#define GT_VOTE_MASK   ((1u << 6) | (1u << 7) | (1u << 10))
+#define GT_RCG         0x21148u
+
+/* GENI serial engine registers (geni-se.h) + SPI extensions (spi-geni). */
+#define SE_STATUS      0x040u
+#define SE_M_CLK_CFG   0x048u
+#define SE_FW          0x068u
+#define SE_CLK_SEL     0x07cu
+#define SE_DMA_MODE    0x258u
+#define SPI_CPHA       0x224u
+#define SPI_CPOL       0x230u
+#define SPI_TRANS_CFG  0x25cu
+#define SPI_WORD_LEN   0x268u
+#define SPI_TX_LEN     0x26cu
+#define SPI_RX_LEN     0x270u
+#define SE_CMD         0x600u
+#define SE_CTRL        0x604u
+#define SE_IRQ         0x610u
+#define SE_IRQ_EN      0x614u
+#define SE_IRQ_CLR     0x618u
+#define SE_TX          0x700u
+#define SE_RX          0x780u
+#define SE_TX_COUNT    0x800u
+#define SE_RX_COUNT    0x804u
+
+#define SPI_OP_TX      1u
+#define SPI_OP_RX      2u
+#define SPI_OP_DUPLEX  3u
+#define SE_DONE        (1u << 0)
+#define SE_ERRORS      (0x0eu | (1u << 9) | (1u << 10) | (1u << 12) | (1u << 13) | \
+                        (1u << 24) | (1u << 25) | (1u << 28) | (1u << 29))
+#define SE_ABORT_DONE  (1u << 5)
+#define SE_TX_READY    (1u << 30)
+#define SE_RX_READY    (1u << 26)
+#define SE_RX_LAST     (1u << 27)
+#define SE_EVENTS      (SE_DONE | SE_ERRORS | SE_ABORT_DONE | SE_RX_READY | \
+                        SE_RX_LAST | SE_TX_READY)
+
+/* TLMM: cfg at pin*0x1000, io latch at cfg+4 (same layout as sweet). */
+#define GT_GPIO_CFG(n) ((uint32_t)(n) * 0x1000u)
+#define GT_GPIO_IO(n)  (GT_GPIO_CFG(n) + 4u)
+
+/*
+ * NT36675 memory map (vendor nt36xxx_mem_map.h; trim id 0x0C/72/66/03).
+ * The 36672A map differs (EVENT_BUF 0x21C00, DMA_CRC_EN 0x3F132) - do not
+ * mix them. SWRST/RD_FAST/ENG_RST come from the gauguin dts.
+ */
+#define NVT_SWRST      0x3f0feu
+#define NVT_RD_FAST    0x3f310u
+#define NVT_ENG_RST    0x7fff80u
+#define NVT_EVENT_BUF  0x22d00u
+/* mainline NVT_TS_PARAMETERS_START / vendor EVENT_MAP_FWINFO */
+#define NVT_FWINFO     (NVT_EVENT_BUF + 0x78u)
+#define NVT_CHIP_ID    0x08u   /* NT36672A per mainline novatek-nvt-ts */
+#define NVT_TRIM_ADDR  (0x1f600u + 0x4eu)
+#define NVT_MAX_TOUCH  10u
+/* Phase-2 host download registers (NT36675, hw_crc=2). */
+#define NVT_BOOT_RDY   0x3f10du
+#define NVT_ILM_DES    0x3f128u
+#define NVT_ILM_LENGTH 0x3f118u
+#define NVT_DLM_DES    0x3f12cu
+#define NVT_DLM_LENGTH 0x3f130u
+#define NVT_G_ILM_CRC  0x3f100u
+#define NVT_G_DLM_CRC  0x3f104u
+#define NVT_R_ILM_CRC  0x3f120u
+#define NVT_R_DLM_CRC  0x3f124u
+#define NVT_BLD_CRC_EN 0x3f30eu
+#define NVT_BLD_CRC_ST 0x3f133u
+#define NVT_EVT_RESET_COMPLETE 0x60u
+#define NVT_EVT_HOST_CMD       0x50u
+
+static struct {
+	vm_offset_t se, gcc, tlmm;
+	bool started, dead;
+	int page;
+	int x[NVT_MAX_TOUCH], y[NVT_MAX_TOUCH];
+	uint32_t active, irq_status;
+	unsigned tx_chunk;          /* bytes pushable per TX_READY event */
+} gt;
+static int gt_sleep_chan;
+
+static uint32_t
+gt_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+gt_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+gt_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&gt_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+gt_wait_clear(vm_offset_t base, uint32_t off, uint32_t mask)
+{
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (!(gt_rd(base, off) & mask)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/* One FIFO SPI transfer: TX-only, RX-only or full-duplex, at most 96 bytes. */
+static int
+gt_xfer(const uint8_t *tx, uint8_t *rx, unsigned len, bool duplex)
+{
+	if (gt.dead || !len || len > 96) {
+		return EIO;
+	}
+	if (!gt_wait_clear(gt.se, SE_STATUS, 1u)) {
+		gt.dead = true; /* no other SE0 owner is supported */
+		return EBUSY;
+	}
+	gt_wr(gt.se, SE_IRQ_CLR, 0xffffffffu);
+	gt_wr(gt.se, SPI_TX_LEN, tx || duplex ? len : 0u);
+	gt_wr(gt.se, SPI_RX_LEN, rx || duplex ? len : 0u);
+	/*
+	 * Linux order (setup_fifo_xfer): M_CMD first, THEN arm the TX
+	 * watermark - the wm write is the event that starts the FIFO pump.
+	 * TX_READY then fires whenever the FIFO is at/below wm and data is
+	 * pushed on it; pre-filling before M_CMD never raises the pump event
+	 * and the sequencer stalls forever (sweetlog24/25: err=60).
+	 */
+	unsigned pushed = 0;
+	gt_wr(gt.se, SE_CMD, ((duplex ? SPI_OP_DUPLEX :
+	    (tx ? SPI_OP_TX : SPI_OP_RX)) << 27));
+	if (tx || duplex) {
+		gt_wr(gt.se, 0x80c, 1);
+	}
+	unsigned got = 0;
+	int err = ETIMEDOUT;
+	for (unsigned i = 0; i < 2000; ++i) {
+		uint32_t irq = gt_rd(gt.se, SE_IRQ);
+		gt.irq_status = irq;
+		if (irq & SE_ERRORS) {
+			err = EIO;
+			goto out;
+		}
+		if ((tx || duplex) && (irq & SE_TX_READY)) {
+			if (pushed < len) {
+				unsigned chunk = len - pushed;
+				if (chunk > gt.tx_chunk) {
+					chunk = gt.tx_chunk;
+				}
+				for (unsigned w = 0; w < chunk; w += 4) {
+					uint32_t v = 0;
+					for (unsigned j = 0; j < 4 && w + j < chunk; ++j) {
+						v |= (uint32_t)tx[pushed + w + j] << (8u * j);
+					}
+					gt_wr(gt.se, SE_TX, v);
+				}
+				pushed += chunk;
+				if (pushed == len) {
+					gt_wr(gt.se, 0x80c, 0); /* disarm: all data is in */
+				}
+			}
+			gt_wr(gt.se, SE_IRQ_CLR, SE_TX_READY);
+		}
+		if (rx || duplex) {
+			uint32_t count = gt_rd(gt.se, SE_RX_COUNT) & 0x1ffffffu;
+			if (count > 64) {
+				err = EIO;
+				goto out;
+			}
+			while (count--) {
+				uint32_t v = gt_rd(gt.se, SE_RX);
+				for (unsigned j = 0; j < 4 && got < len; ++j) {
+					rx[got++] = (uint8_t)(v >> (8u * j));
+				}
+			}
+		}
+		if (irq & SE_DONE) {
+			gt_wr(gt.se, SE_IRQ_CLR, irq);
+			if ((!(tx || duplex) || pushed == len) &&
+			    (!(rx || duplex) || got == len)) {
+				return 0;
+			}
+			err = EIO;
+			goto out;
+		}
+		/* Preserve the in-progress events; DONE/errors keep their bits. */
+		gt_wr(gt.se, SE_IRQ_CLR, irq & (SE_ABORT_DONE | SE_RX_READY |
+		    SE_RX_LAST));
+		delay(1);
+	}
+out:
+	if (err == ETIMEDOUT) {
+		printf("GAUGUIN TOUCH: stall len=%u pushed=%u got=%u status=%#x "
+		    "txwc=%u rxwc=%u\n", len, pushed, got, gt_rd(gt.se, SE_STATUS),
+		    gt_rd(gt.se, SE_TX_COUNT) & 0xfffffffu,
+		    gt_rd(gt.se, SE_RX_COUNT) & 0x1ffffffu);
+	}
+	gt_wr(gt.se, SE_CTRL, 2); /* abort M command, release the bus */
+	bool done = false;
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (gt_rd(gt.se, SE_IRQ) & SE_ABORT_DONE) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	if (!done || !gt_wait_clear(gt.se, SE_STATUS, 1u)) {
+		gt.dead = true;
+		printf("GAUGUIN TOUCH: abort failed status=%#x irq=%#x; stopping\n",
+		    gt_rd(gt.se, SE_STATUS), gt_rd(gt.se, SE_IRQ));
+	}
+	for (unsigned i = 0; i < 64 && (gt_rd(gt.se, SE_RX_COUNT) & 0x1ffffffu); ++i) {
+		(void)gt_rd(gt.se, SE_RX);
+	}
+	gt_wr(gt.se, SE_IRQ_CLR, 0xffffffffu);
+	if (gt_rd(gt.se, SE_TX_COUNT) & 0xfffffffu) {
+		gt.dead = true;
+		printf("GAUGUIN TOUCH: abort left %u tx words\n",
+		    gt_rd(gt.se, SE_TX_COUNT) & 0xfffffffu);
+	}
+	return err;
+}
+
+/* Novatek page-addressed protocol. Writes carry the 0x80 command bit. */
+static int
+nvt_write(const uint8_t *buf, unsigned len)
+{
+	uint8_t b[96];
+	memcpy(b, buf, len > 96 ? 96 : len);
+	b[0] |= 0x80u;
+	return gt_xfer(b, NULL, len, false);
+}
+
+/* Read: full-duplex reg + dummy + data (data starts at rx word offset 2). */
+static int
+nvt_read(uint8_t reg, uint8_t *out, unsigned ndata)
+{
+	uint8_t tx[96], rx[96];
+	unsigned len = ndata + 2;
+	if (len > 96) {
+		return EIO;
+	}
+	memset(tx, 0, len);
+	tx[0] = reg & 0x7fu;
+	int err = gt_xfer(tx, rx, len, true);
+	if (err) {
+		return err;
+	}
+	memcpy(out, rx + 2, ndata);
+	return 0;
+}
+
+static int
+nvt_set_page(uint32_t addr)
+{
+	int page = (int)(addr >> 7);
+	if (page == gt.page) {
+		return 0;
+	}
+	uint8_t b[3] = {0xffu, (uint8_t)(addr >> 15), (uint8_t)(addr >> 7)};
+	int err = nvt_write(b, 3);
+	if (!err) {
+		gt.page = page;
+	}
+	return err;
+}
+
+static int
+nvt_write_addr(uint32_t addr, uint8_t val)
+{
+	int err = nvt_set_page(addr);
+	if (err) {
+		return err;
+	}
+	uint8_t b[2] = {(uint8_t)(addr & 0x7fu), val};
+	return nvt_write(b, 2);
+}
+
+static int
+nvt_read_addr(uint32_t addr, uint8_t *out, unsigned ndata)
+{
+	int err = nvt_set_page(addr);
+	if (err) {
+		return err;
+	}
+	return nvt_read((uint8_t)(addr & 0x7fu), out, ndata);
+}
+
+static void
+gt_pin(unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out)
+{
+	uint32_t off = GT_GPIO_CFG(pin);
+	uint32_t cfg = gt_rd(gt.tlmm, off);
+	if (out) {
+		/* Set the output latch before enabling output, avoiding a glitch. */
+		gt_wr(gt.tlmm, GT_GPIO_IO(pin),
+		    gt_rd(gt.tlmm, GT_GPIO_IO(pin)) | 2u);
+	}
+	cfg &= ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	gt_wr(gt.tlmm, off, cfg);
+}
+
+static bool
+gt_clocks(void)
+{
+	gt_wr(gt.gcc, GT_VOTE, gt_rd(gt.gcc, GT_VOTE) | GT_VOTE_MASK);
+	printf("GAUGUIN TOUCH: vote=%#x (mask %#x)\n",
+	    gt_rd(gt.gcc, GT_VOTE), GT_VOTE_MASK);
+	/* Parent 0 = XO 19.2 MHz, divider 1; M/N bypassed (N = 0). */
+	gt_wr(gt.gcc, GT_RCG + 4u, gt_rd(gt.gcc, GT_RCG + 4u) & ~0x371fu);
+	gt_wr(gt.gcc, GT_RCG + 8u, 0);
+	gt_wr(gt.gcc, GT_RCG + 0xcu, 0);
+	gt_wr(gt.gcc, GT_RCG + 0x10u, 0);
+	gt_wr(gt.gcc, GT_RCG, gt_rd(gt.gcc, GT_RCG) | 1u);
+	if (!gt_wait_clear(gt.gcc, GT_RCG, 1u)) {
+		printf("GAUGUIN TOUCH: RCG update timeout cmd=%#x\n",
+		    gt_rd(gt.gcc, GT_RCG));
+		return false;
+	}
+	printf("GAUGUIN TOUCH: rcg cmd=%#x cfg=%#x\n",
+	    gt_rd(gt.gcc, GT_RCG), gt_rd(gt.gcc, GT_RCG + 4u));
+	/*
+	 * BRANCH_HALT_VOTED + HWCG: CLK_OFF (bit 31) reads 1 while the
+	 * engine is idle - that is the hardware clock gate doing its job,
+	 * not a failed vote (Linux never waits for these when enabling).
+	 * Read-only diagnostics; the first SE access un-gates the AHB.
+	 */
+	printf("GAUGUIN TOUCH: branches m_ahb=%#x s_ahb=%#x s0=%#x\n",
+	    gt_rd(gt.gcc, 0x21004), gt_rd(gt.gcc, 0x21008),
+	    gt_rd(gt.gcc, 0x21144));
+	return true;
+}
+
+static bool
+gt_se_init(void)
+{
+	uint32_t fw = gt_rd(gt.se, SE_FW);
+	uint32_t tx = gt_rd(gt.se, 0xe24), rx = gt_rd(gt.se, 0xe28);
+	uint32_t fifo_dis = gt_rd(gt.se, 0x64);
+	printf("GAUGUIN TOUCH: se0 fw=%#x proto=%u status=%#x tx=%#x rx=%#x\n",
+	    fw, (fw >> 8) & 0xffu, gt_rd(gt.se, SE_STATUS), tx, rx);
+	printf("GAUGUIN TOUCH: fifo_if_disable=%u (1 = GSI-only fw, FIFO dead)\n",
+	    fifo_dis & 1u);
+	if (fifo_dis & 1u) {
+		printf("GAUGUIN TOUCH: SE0 firmware is GSI/DMA-only; stopping\n");
+		return false;
+	}
+	/* GENI_SE_SPI = protocol 1; the ABL/aop must have loaded the SE image. */
+	if (((fw >> 8) & 0xffu) != 1u) {
+		printf("GAUGUIN TOUCH: GENI SPI firmware not loaded; stopping\n");
+		return false;
+	}
+	if (gt_rd(gt.se, SE_STATUS) & 0x1001u) {
+		printf("GAUGUIN TOUCH: SE0 already busy; stopping\n");
+		return false;
+	}
+	gt_wr(gt.se, 0xe18, 0); /* no GSI events */
+	gt_wr(gt.se, 0xe1c, 0); /* mask external IRQ routing; poll local status */
+	gt_wr(gt.se, 0x644, 0);
+	gt_wr(gt.se, SE_IRQ_CLR, 0xffffffffu);
+	gt_wr(gt.se, 0x648, 0xffffffffu);
+	gt_wr(gt.se, SE_DMA_MODE, 0);
+	gt_wr(gt.se, 0x28, gt_rd(gt.se, 0x28) | 0x7fu);
+	gt_wr(gt.se, 0xe30, gt_rd(gt.se, 0xe30) | 0x0fu);
+	gt_wr(gt.se, 0x24, 0x7f);
+	gt_wr(gt.se, 0x20, 1);
+	gt_wr(gt.se, SE_CLK_SEL, 0);                    /* XO */
+	gt_wr(gt.se, SE_M_CLK_CFG, (2u << 4) | 1u);      /* SCK 4.8 MHz */
+	gt_wr(gt.se, SPI_CPHA, 0);                       /* mode 0 */
+	gt_wr(gt.se, SPI_CPOL, 0);
+	gt_wr(gt.se, 0x22c, 0);                          /* no loopback */
+	/*
+	 * CS demux: selects which of the 4 CS outputs the sequencer drives
+	 * (Linux writes SE_SPI_DEMUX_SEL = chip_select in setup_fifo_params).
+	 * Without it the engine never asserts CS and M_CMD never completes
+	 * (sweetlog21: TX watermark stuck, DONE never arrives, err=60).
+	 */
+	gt_wr(gt.se, 0x250, 0);                          /* CS0 = gpio3 */
+	gt_wr(gt.se, 0x24c, 0);                          /* CS active low */
+	gt_wr(gt.se, SPI_TRANS_CFG, 0);                  /* Linux: spi_tx_cfg &= ~CS_TOGGLE */
+	/*
+	 * SE_SPI_WORD_LEN counts MIN_WORD_LEN (4): 8-bit words -> 8-4 = 4.
+	 * (v5 wrote 0 = 4-bit words: the sequencer miscounted the transfer
+	 * length and M_CMD never completed - sweetlog21/22 err=60.)
+	 */
+	gt_wr(gt.se, SPI_WORD_LEN, 4u);
+	/*
+	 * FIFO packing: SPI is MSB-first (mode 0, no SPI_LSB_FIRST) - NOT the
+	 * I2C LSB config sweet used. geni_se_config_packing(bpw=8, pack=4,
+	 * msb_to_lsb=1): vec starts 7/15/23/31, len 7, dir 1, last |STOP.
+	 * FIFO bits[7:0] are sent first; the prefill below stores tx[0] there.
+	 */
+	unsigned tx_depth = (tx >> 16) & 0x3fu;
+	if (!tx_depth) {
+		tx_depth = 16;
+	}
+	printf("GAUGUIN TOUCH: fifo depth=%u width=%u bits\n",
+	    tx_depth, (tx >> 24) & 0x3fu);
+	/* (depth - wm) words per TX_READY event, like Linux handle_tx. */
+	gt.tx_chunk = (tx_depth - 1u) * 4u;
+	/*
+	 * geni_se_config_packing(bpw=8, pack=4, msb): vectors start at
+	 * bits 7/15/23/31, len=7, dir=1, STOP on the last ->
+	 * CFG0 = 0x0007F8FE, CFG1 = 0x000FFEFE. v6 wrote the 9-digit
+	 * 0x000ffeefeu (= 0xFFEEFE): vector2 became start-31/len-5/STOP and
+	 * vector3 start-7/dir-0 - a garbled unpack table that stalled M_CMD
+	 * (sweetlog24/25 err=60, only the TX watermark bit set).
+	 * The first byte sent/received is FIFO word bits [7:0].
+	 */
+	gt_wr(gt.se, 0x260, 0x0007f8feu);
+	gt_wr(gt.se, 0x264, 0x000ffefeu);
+	gt_wr(gt.se, 0x284, 0x0007f8feu);
+	gt_wr(gt.se, 0x288, 0x000ffefeu);
+	gt_wr(gt.se, 0x80c, 0); /* armed per-transfer after M_CMD (Linux) */
+	gt_wr(gt.se, 0x810, 0);
+	gt_wr(gt.se, 0x814, ((rx >> 16) & 0x3fu) ? (((rx >> 16) & 0x3fu) - 1u) : 0u);
+	gt_wr(gt.se, SE_IRQ_EN, SE_EVENTS);
+	if ((gt_rd(gt.se, SE_TX_COUNT) & 0xfffffffu) ||
+	    (gt_rd(gt.se, SE_RX_COUNT) & 0x1ffffffu)) {
+		printf("GAUGUIN TOUCH: inherited FIFO data; stopping\n");
+		return false;
+	}
+	return true;
+}
+
+/*
+ * Write `size` bytes into bootloader SRAM at `sram` (vendor
+ * nvt_write_sram): <=64-byte chunks that never cross the 128-byte xdata
+ * page (set_page + write at page offset). The engine FIFO transfer limit
+ * is 96 bytes per gt_xfer.
+ */
+static int
+nvt_write_sram(const uint8_t *data, uint32_t sram, uint32_t size)
+{
+	while (size) {
+		uint32_t off = sram & 0x7fu;
+		uint32_t chunk = 0x80u - off;
+		uint8_t b[65];
+		int err;
+		if (chunk > 64u) {
+			chunk = 64u;
+		}
+		if (chunk > size) {
+			chunk = size;
+		}
+		err = nvt_set_page(sram);
+		if (err) {
+			return err;
+		}
+		b[0] = (uint8_t)off;
+		memcpy(b + 1, data, chunk);
+		err = nvt_write(b, chunk + 1u);
+		if (err) {
+			return err;
+		}
+		data += chunk;
+		sram += chunk;
+		size -= chunk;
+	}
+	return 0;
+}
+
+/* One CRC-bank register set (vendor nvt_set_bld_crc_bank, hw_crc=2:
+ * destination 3B, length 4B (bit 24 = size>>16), golden checksum 4B,
+ * all inside one xdata page). */
+static int
+nvt_crc_bank(uint32_t des_addr, uint32_t sram, uint32_t len_addr,
+    uint32_t size, uint32_t g_addr, uint32_t crc)
+{
+	uint8_t b[5];
+	int err = nvt_set_page(des_addr);
+	if (err) {
+		return err;
+	}
+	b[0] = (uint8_t)(des_addr & 0x7fu);
+	b[1] = (uint8_t)sram;
+	b[2] = (uint8_t)(sram >> 8);
+	b[3] = (uint8_t)(sram >> 16);
+	err = nvt_write(b, 4);
+	if (err) {
+		return err;
+	}
+	b[0] = (uint8_t)(len_addr & 0x7fu);
+	b[1] = (uint8_t)size;
+	b[2] = (uint8_t)(size >> 8);
+	b[3] = (uint8_t)((size >> 16) & 1u);
+	err = nvt_write(b, 4);
+	if (err) {
+		return err;
+	}
+	b[0] = (uint8_t)(g_addr & 0x7fu);
+	b[1] = (uint8_t)crc;
+	b[2] = (uint8_t)(crc >> 8);
+	b[3] = (uint8_t)(crc >> 16);
+	b[4] = (uint8_t)(crc >> 24);
+	return nvt_write(b, 5);
+}
+
+/*
+ * Vendor nvt_download_firmware_hw_crc: assumes the IC is already in the
+ * bootloader (pathB SWRST). Returns 0 when the firmware reports reset
+ * complete (event+0x60 >= 1).
+ */
+static int
+nvt_download_fw(const uint8_t *fw)
+{
+	uint32_t end = (uint32_t)fw[0] | ((uint32_t)fw[1] << 8) |
+	    ((uint32_t)fw[2] << 16) | ((uint32_t)fw[3] << 24);
+	uint32_t ilm_bin, ilm_sram, ilm_size;
+	uint32_t dlm_bin, dlm_sram, dlm_size, ilm_crc, dlm_crc;
+	uint8_t b[8];
+	int err;
+	ilm_bin = (uint32_t)fw[0] | ((uint32_t)fw[1] << 8) |
+	    ((uint32_t)fw[2] << 16) | ((uint32_t)fw[3] << 24);
+	ilm_sram = (uint32_t)fw[4] | ((uint32_t)fw[5] << 8) |
+	    ((uint32_t)fw[6] << 16) | ((uint32_t)fw[7] << 24);
+	ilm_size = (uint32_t)fw[8] | ((uint32_t)fw[9] << 8) |
+	    ((uint32_t)fw[10] << 16) | ((uint32_t)fw[11] << 24);
+	dlm_bin = (uint32_t)fw[12] | ((uint32_t)fw[13] << 8) |
+	    ((uint32_t)fw[14] << 16) | ((uint32_t)fw[15] << 24);
+	dlm_sram = (uint32_t)fw[16] | ((uint32_t)fw[17] << 8) |
+	    ((uint32_t)fw[18] << 16) | ((uint32_t)fw[19] << 24);
+	dlm_size = (uint32_t)fw[20] | ((uint32_t)fw[21] << 8) |
+	    ((uint32_t)fw[22] << 16) | ((uint32_t)fw[23] << 24);
+	ilm_crc = (uint32_t)fw[0x18] | ((uint32_t)fw[0x19] << 8) |
+	    ((uint32_t)fw[0x1a] << 16) | ((uint32_t)fw[0x1b] << 24);
+	dlm_crc = (uint32_t)fw[0x1c] | ((uint32_t)fw[0x1d] << 8) |
+	    ((uint32_t)fw[0x1e] << 16) | ((uint32_t)fw[0x1f] << 24);
+	printf("GAUGUIN TOUCH: fw hdr end=%#x ILM sram@%#x sz=%u crc=%#x "
+	    "DLM sram@%#x sz=%u crc=%#x\n", end, ilm_sram, ilm_size, ilm_crc,
+	    dlm_sram, dlm_size, dlm_crc);
+	/* clear fw reset status (event page) */
+	(void)nvt_write_addr(NVT_EVENT_BUF | NVT_EVT_RESET_COMPLETE, 0x00);
+	/* write ILM then DLM (vendor writes size+1) */
+	err = nvt_write_sram(fw + ilm_bin, ilm_sram, ilm_size + 1u);
+	if (err) {
+		printf("GAUGUIN TOUCH: ILM write err=%d\n", err);
+		return err;
+	}
+	printf("GAUGUIN TOUCH: ILM written (%u B)\n", ilm_size);
+	err = nvt_write_sram(fw + dlm_bin, dlm_sram, dlm_size + 1u);
+	if (err) {
+		printf("GAUGUIN TOUCH: DLM write err=%d\n", err);
+		return err;
+	}
+	printf("GAUGUIN TOUCH: DLM written (%u B)\n", dlm_size);
+	/* CRC banks (hw_crc = 2: 4-byte length) */
+	err = nvt_crc_bank(NVT_ILM_DES, ilm_sram, NVT_ILM_LENGTH, ilm_size,
+	    NVT_G_ILM_CRC, ilm_crc);
+	if (err) {
+		return err;
+	}
+	err = nvt_crc_bank(NVT_DLM_DES, dlm_sram, NVT_DLM_LENGTH, dlm_size,
+	    NVT_G_DLM_CRC, dlm_crc);
+	if (err) {
+		return err;
+	}
+	/* BLD_CRC_EN |= 0x80 */
+	{
+		uint8_t cur[2] = {0};
+		err = nvt_read_addr(NVT_BLD_CRC_EN, cur, 1);
+		if (err) {
+			return err;
+		}
+		err = nvt_write_addr(NVT_BLD_CRC_EN, cur[0] | 0x80u);
+		if (err) {
+			return err;
+		}
+	}
+	/* fw crc enable: reset-complete = 0, host-cmd = 0xAE */
+	(void)nvt_write_addr(NVT_EVENT_BUF | NVT_EVT_RESET_COMPLETE, 0x00);
+	(void)nvt_write_addr(NVT_EVENT_BUF | NVT_EVT_HOST_CMD, 0xAE);
+	/* boot ready */
+	err = nvt_write_addr(NVT_BOOT_RDY, 1);
+	if (err) {
+		printf("GAUGUIN TOUCH: BOOT_RDY err=%d\n", err);
+		return err;
+	}
+	gt_wait(5);
+	/* poll reset state (0xA0..0xAF = RESET_STATE_INIT..MAX) 10x10ms */
+	uint8_t st_last = 0;
+	for (unsigned i = 0; i < 10; ++i) {
+		uint8_t st[6] = {0};
+		err = nvt_read_addr(NVT_EVENT_BUF | NVT_EVT_RESET_COMPLETE, st, 1);
+		st_last = st[0];
+		if (!err && st[0] >= 0xA0u && st[0] <= 0xAFu) {
+			printf("GAUGUIN TOUCH: fw reset complete=%#x (try %u)\n",
+			    st[0], i);
+			/* checksum readback (diagnostic) */
+			uint8_t c[4] = {0};
+			(void)nvt_read_addr(NVT_R_ILM_CRC, c, 4);
+			printf("GAUGUIN TOUCH: R_ILM=%02x%02x%02x%02x (want %#x)\n",
+			    c[0], c[1], c[2], c[3], ilm_crc);
+			(void)nvt_read_addr(NVT_R_DLM_CRC, c, 4);
+			printf("GAUGUIN TOUCH: R_DLM=%02x%02x%02x%02x (want %#x)\n",
+			    c[0], c[1], c[2], c[3], dlm_crc);
+			return 0;
+		}
+		gt_wait(10);
+	}
+	printf("GAUGUIN TOUCH: fw reset state timeout err=%d last=%#x\n", err, st_last);
+	return ETIMEDOUT;
+}
+
+/* Frame: 10 slots x 6 bytes; slot[0] = id<<3 | status, 1/2 = down. */
+static void
+gt_report(const uint8_t *frame)
+{
+	int x[NVT_MAX_TOUCH] = {0}, y[NVT_MAX_TOUCH] = {0};
+	uint32_t mask = 0;
+	for (unsigned i = 0; i < NVT_MAX_TOUCH; ++i) {
+		const uint8_t *p = frame + 6u * i;
+		unsigned id = p[0] >> 3, st = p[0] & 7u;
+		if (id == 0 || id > NVT_MAX_TOUCH || (st != 1u && st != 2u)) {
+			continue;
+		}
+		unsigned px = ((unsigned)p[1] << 4) | (p[3] >> 4);
+		unsigned py = ((unsigned)p[2] << 4) | (p[3] & 0xfu);
+		if (px > 1079u || py > 2399u) {
+			continue;
+		}
+		mask |= 1u << (id - 1);
+		x[id - 1] = (int)px;
+		y[id - 1] = (int)py;
+	}
+	for (unsigned i = 0; i < NVT_MAX_TOUCH; ++i) {
+		uint32_t bit = 1u << i;
+		if (mask & bit) {
+			if (!(gt.active & bit) || x[i] != gt.x[i] || y[i] != gt.y[i]) {
+				sweet_hid_touch((int)i, 1, x[i], y[i]);
+			}
+			gt.x[i] = x[i];
+			gt.y[i] = y[i];
+		} else if (gt.active & bit) {
+			sweet_hid_touch((int)i, 0, gt.x[i], gt.y[i]);
+		}
+	}
+	gt.active = mask;
+}
+
+static void
+gt_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 45, errors = 0;
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("gauguintouchdelay", &delay_s, sizeof(delay_s));
+	printf("GAUGUIN TOUCH: starting in %u s\n", delay_s);
+	gt_wait(delay_s * 1000u);
+	printf("GAUGUIN TOUCH: step1 mapping GCC/TLMM/SE0\n");
+	gt.gcc = ml_io_map(GT_GCC_PA, 0x60000);
+	gt.tlmm = ml_io_map(GT_TLMM_PA, 0x5b0000);
+	gt.se = ml_io_map(GT_SE_PA, 0x4000);
+	if (!gt.gcc || !gt.tlmm || !gt.se) {
+		printf("GAUGUIN TOUCH: MMIO mapping failed\n");
+		goto out;
+	}
+	printf("GAUGUIN TOUCH: step2 tlmm qup00 muxing\n");
+	gt_pin(0, 2, 0, 3, false);  /* SCK, 6 mA (vendor dtsi) */
+	gt_pin(1, 2, 0, 3, false);  /* MISO */
+	gt_pin(2, 1, 0, 3, false);  /* MOSI */
+	gt_pin(3, 1, 0, 3, false);  /* CS  */
+	gt_pin(22, 0, 3, 0, false); /* irq input, pull-up */
+	/* Hold the IC in reset while the engine comes up. */
+	gt_pin(21, 0, 0, 2, false); /* reset low */
+	printf("GAUGUIN TOUCH: step3 clocks\n");
+	if (!gt_clocks()) {
+		goto out;
+	}
+	printf("GAUGUIN TOUCH: step4 se init\n");
+	if (!gt_se_init()) {
+		goto out;
+	}
+	printf("GAUGUIN TOUCH: step5 releasing reset (flash-boot path)\n");
+	gt_pin(21, 0, 0, 2, true);  /* release reset */
+	gt_wait(200);               /* mainline: msleep(100) after release */
+	printf("GAUGUIN TOUCH: irq=%#x rst released\n",
+	    gt_rd(gt.tlmm, GT_GPIO_IO(22)));
+	/*
+	 * Path A (mainline novatek-nvt-ts.c): with flash firmware the IC is
+	 * just... running. Read the fwinfo parameter block from the event
+	 * page and check for sane values (layout per mainline: +4 width BE16,
+	 * +6 height BE16, +9 max_touches, +0xb irq_type, +0xe chip_id).
+	 */
+	uint8_t fwinfo[15] = {0};
+	int ferr = nvt_read_addr(NVT_FWINFO, fwinfo, sizeof(fwinfo));
+	unsigned fw_w = ((unsigned)fwinfo[4] << 8) | fwinfo[5];
+	unsigned fw_h = ((unsigned)fwinfo[6] << 8) | fwinfo[7];
+	unsigned fw_max = fwinfo[9];
+	unsigned fw_irq = fwinfo[0xb];
+	unsigned fw_chip = fwinfo[0xe];
+	printf("GAUGUIN TOUCH: pathA fwinfo err=%d w=%u h=%u max=%u irq=%u "
+	    "chip=%02x | %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x "
+	    "%02x %02x %02x %02x\n", ferr, fw_w, fw_h, fw_max, fw_irq, fw_chip,
+	    fwinfo[0], fwinfo[1], fwinfo[2], fwinfo[3], fwinfo[4], fwinfo[5],
+	    fwinfo[6], fwinfo[7], fwinfo[8], fwinfo[9], fwinfo[10], fwinfo[11],
+	    fwinfo[12], fwinfo[13], fwinfo[14]);
+	bool fw_running = !ferr && (fw_chip == NVT_CHIP_ID ||
+	    (fw_w >= 300 && fw_w <= 4096 && fw_h >= 300 && fw_h <= 4096 &&
+	    fw_max >= 1 && fw_max <= 10));
+	if (fw_running) {
+		printf("GAUGUIN TOUCH: flash firmware RUNNING (mainline path)\n");
+	}
+	/*
+	 * Vendor check_chip_ver_trim: up to 5 tries, each one a fresh
+	 * bootloader reset (SWRST 0x69, tBRST2FR 5ms, SPI_RD_FAST off)
+	 * followed by set_page + a 7-byte read at reg 0x4E. The whole frame
+	 * is dumped: rx[0] echoes the address byte (IC alive), rx[1] is the
+	 * dummy, rx[2..7] are the id (v7 read page 0x1F600 = 128x the right
+	 * page 0x3EC - blank xdata - hence all FF).
+	 */
+	int err = 0;
+	if (!fw_running) {
+		/*
+		 * Path B (vendor fw_update.c 1021): "Keep TP_RESX low when send
+		 * eng reset cmd" - hold reset, 1 ms, eng reset write, release,
+		 * 10 ms, then the SWRST bootloader entry + trim read.
+		 */
+		printf("GAUGUIN TOUCH: pathB eng reset (TP_RESX low)\n");
+		gt_pin(21, 0, 0, 2, false); /* hold reset low */
+		gt_wait(2);
+		(void)nvt_write_addr(NVT_ENG_RST, 0x5A);
+		gt_pin(21, 0, 0, 2, true);  /* release */
+		gt_wait(10);
+	}
+	uint8_t trim[6] = {0};
+	bool known = fw_running;
+	printf("GAUGUIN TOUCH: step6 bootloader reset (pathB)\n");
+	for (unsigned try = 1; try <= 5 && !known; ++try) {
+		err = nvt_write_addr(NVT_SWRST, 0x69);
+		if (err) {
+			printf("GAUGUIN TOUCH: bl reset err=%d irq=%#x (try %u)\n",
+			    err, gt.irq_status, try);
+			gt_wait(10);
+			continue;
+		}
+		gt_wait(5);  /* tBRST2FR */
+		(void)nvt_write_addr(NVT_RD_FAST, 0);
+		uint8_t frame[8] = {0};
+		err = nvt_read_addr(NVT_TRIM_ADDR, frame + 2, 6);
+		memcpy(trim, frame + 2, 6);
+		printf("GAUGUIN TOUCH: trim try%u frame=%02x %02x | id=%02x %02x %02x "
+		    "%02x %02x %02x err=%d irq=%#x\n", try, frame[0], frame[1],
+		    trim[0], trim[1], trim[2], trim[3], trim[4], trim[5],
+		    err, gt.irq_status);
+		/*
+	 * Vendor trim table: 0x0C/xx/xx/72/66/03 = NT36675 (this unit),
+	 * 0x0B|0x0A/xx/xx/72/66/03 = NT36672A family. Both share the
+	 * download protocol; only the memory map differs (we use NT36675).
+	 */
+		known = !err && (trim[3] == 0x72 && trim[4] == 0x66 &&
+		    trim[5] == 0x03 && (trim[0] == 0x0c || trim[0] == 0x0b ||
+		    trim[0] == 0x0a));
+	}
+	if (!known) {
+		printf("GAUGUIN TOUCH: unsupported/absent IC; stopping\n");
+		goto out;
+	}
+	if (!fw_running) {
+		/*
+		 * Flash is empty (pathA saw nothing at 0x22D78): host-download
+		 * the embedded NT36675 firmware, then re-check fwinfo. The IC is
+		 * still in the bootloader from the trim read (SWRST above).
+		 */
+		unsigned fw_sel = 1;
+		const uint8_t *fw;
+		(void)PE_parse_boot_argn("gauguintouchfw", &fw_sel,
+		    sizeof(fw_sel));
+		fw = (fw_sel == 2u) ? nvt_fw02 : nvt_fw01;
+		printf("GAUGUIN TOUCH: downloading NT36675 fw%u (%u B)\n",
+		    fw_sel, (fw_sel == 2u) ? nvt_fw02_len : nvt_fw01_len);
+		err = nvt_download_fw(fw);
+		if (err) {
+			printf("GAUGUIN TOUCH: fw download failed err=%d; stopping\n",
+		    err);
+			goto out;
+		}
+		/* firmware is up: re-read the parameter block */
+		ferr = nvt_read_addr(NVT_FWINFO, fwinfo, sizeof(fwinfo));
+		fw_w = ((unsigned)fwinfo[4] << 8) | fwinfo[5];
+		fw_h = ((unsigned)fwinfo[6] << 8) | fwinfo[7];
+		fw_max = fwinfo[9];
+		printf("GAUGUIN TOUCH: post-dl fwinfo err=%d w=%u h=%u max=%u "
+		    "chip=%02x\n", ferr, fw_w, fw_h, fw_max, fwinfo[0xe]);
+		fw_running = !ferr && (fw_chip == NVT_CHIP_ID ||
+		    (fw_w >= 300 && fw_w <= 4096 && fw_h >= 300 && fw_h <= 4096));
+	}
+	/* Restart: with flash firmware the IC runs it; without, it stays in
+	 * the bootloader and the event buffer stays silent (needs the .bin). */
+	err = nvt_write_addr(NVT_SWRST, 0x69);
+	gt_wait(500);
+	uint8_t ev[60] = {0};
+	err = nvt_read_addr(NVT_EVENT_BUF, ev, sizeof(ev));
+	printf("GAUGUIN TOUCH: event head=%02x %02x %02x %02x err=%d irq=%#x\n",
+	    ev[0], ev[1], ev[2], ev[3], err, gt.irq_status);
+	printf("GAUGUIN TOUCH: polling 1080x2400 every 20 ms\n");
+	while (!gt.dead) {
+		gt_wait(errors > 10 ? 1000u : 20u); /* back off when the IC is silent */
+		err = nvt_read_addr(NVT_EVENT_BUF, ev, sizeof(ev));
+		if (err) {
+			if ((errors++ % 50u) == 0) {
+				printf("GAUGUIN TOUCH: read err=%d irq=%#x\n", err, gt.irq_status);
+			}
+			continue;
+		}
+		errors = 0;
+		gt_report(ev);
+	}
+out:
+	printf("GAUGUIN TOUCH: thread exit\n");
+	/* kernel_thread_start threads must not return (continuation panic). */
+	(void)thread_terminate(current_thread());
+}
+
+void
+gauguin_touch_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	if (gt.started) {
+		return;
+	}
+	gt.started = true;
+	(void)PE_parse_boot_argn("gauguintouch", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("GAUGUIN TOUCH: disabled (gauguintouch=0)\n");
+		return;
+	}
+	kern_return_t kr = kernel_thread_start(gt_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("GAUGUIN TOUCH: kernel_thread_start failed %d\n", kr);
+	}
+}
