+/*
+ * gauguin NT36675 touch firmware (novatek_ts_fw01/02.bin - tianma/
+ * csot panel variants) from the LineageOS android_kernel_xiaomi_
+ * gauguin firmware/ ihex blobs. Generated - do not edit.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/types.h>
