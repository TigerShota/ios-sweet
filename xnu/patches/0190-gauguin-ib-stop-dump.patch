+		 * Walk the dwords around the stop site page by page through the
+		 * cached gg_san_map() and decode the header the CP is about to
+		 * execute.
+		 */
+		for (k = 0; k < count; k++) {
+			uint32_t at0, lo, hi, idx, hh, tt, r0;
+			vm_offset_t mp;
+
+			if ((uint32_t)ai[k] != stuck || rem == 0u ||
+			    rem > wi[k]) {
+				continue;
+			}
+			at0 = wi[k] - rem;
+			lo = at0 > 8u ? at0 - 8u : 0u;
+			hi = at0 + 48u < wi[k] ? at0 + 48u : wi[k];
+			printf("GAUGUIN CP: 0190 stop ib=%u iova=%#llx at=%u"
