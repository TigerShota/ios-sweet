+/* Clean the CPU cache for a GEM range before/after the GPU touches it. */
+void
+gauguin_gem_flush(uint64_t iova, uint64_t size)
+{
+	uint64_t a, end;
+
+	if (!gem_ready) {
+		return;
+	}
+	end = iova + size;
+	if (end < iova) {
+		end = iova;
+	}
+	for (a = iova & ~(uint64_t)(GEM_PAGE - 1u); a < end; a += GEM_PAGE) {
+		uint32_t tbl;
+		uint64_t e;
+
+		if (!gg_gem_l2(a, &tbl)) {
+			continue;
+		}
+		e = *(volatile uint64_t *)(gem_l3 + 0x1000u * tbl +
+		    8u * ((a >> 12) & 0x1ffu));
+		if ((e & 3u) == 0u) {
+			continue;
+		}
+		flush_dcache64((addr64_t)(e & ~0xfffull), GEM_PAGE, TRUE);
+	}
+}
