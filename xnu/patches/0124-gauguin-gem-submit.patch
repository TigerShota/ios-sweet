+/*
+ * 0124 self-test: the whole userspace path without userspace. Two GEM
+ * buffers, one command stream that writes two words through the GPU, one
+ * CP_INDIRECT_BUFFER submission, one fence. PASS means the SMMU mapping,
+ * the IB fetch and the completion fence all work.
+ */
+static void
+gauguin_gem_selftest(void)
+{
+	int enabled = 1;
+	vm_offset_t ib_kva = 0, data_kva = 0;
+	ppnum_t ib_pn = 0, data_pn = 0;
+	uint64_t ib_iova, data_iova;
+	uint32_t *ib;
+	uint32_t n = 0, words = 0, fence = 0;
+	uint32_t mw, ev;
+	kern_return_t kr;
+
+	(void)PE_parse_boot_argn("gauguingputest", &enabled, sizeof(enabled));
+	if (!enabled) {
+		return;
+	}
+	if (!gem_ready) {
+		printf("GAUGUIN GEM: selftest skipped (no window)\n");
+		(void)sweet_log_flush_now();
+		return;
+	}
+	kr = kmem_alloc_contig(kernel_map, &ib_kva, GEM_PAGE, 0,
+	    0xffffffffu, 0u, 0u, 1u);
+	kr = kr ? kr : kmem_alloc_contig(kernel_map, &data_kva, GEM_PAGE, 0,
+	    0xffffffffu, 0u, 0u, 1u);
+	if (kr != KERN_SUCCESS || ib_kva == 0 || data_kva == 0) {
+		printf("GAUGUIN GEM: selftest alloc failed %d\n", kr);
+		(void)sweet_log_flush_now();
+		return;
+	}
+	ib_pn = pmap_find_phys(kernel_pmap, (addr64_t)ib_kva);
+	data_pn = pmap_find_phys(kernel_pmap, (addr64_t)data_kva);
+	ib_iova = gauguin_gem_address(GEM_PAGE);
+	data_iova = gauguin_gem_address(GEM_PAGE);
+	if (!ib_pn || !data_pn || !ib_iova || !data_iova ||
+	    !gauguin_gem_map(ib_iova, ptoa_64(ib_pn), 0) ||
+	    !gauguin_gem_map(data_iova, ptoa_64(data_pn), 0)) {
+		printf("GAUGUIN GEM: selftest map failed\n");
+		(void)sweet_log_flush_now();
+		return;
+	}
+	gauguin_gem_tlb_flush();
+
+	*(volatile uint32_t *)data_kva = 0u;
+	*(volatile uint32_t *)(data_kva + 4u) = 0u;
+	flush_dcache64((addr64_t)ptoa_64(data_pn), GEM_PAGE, TRUE);
+
+	ib = (uint32_t *)ib_kva;
+	bzero(ib, GEM_PAGE);
+	ib[n++] = gg_pkt7(0x3du, 3u);          /* CP_MEM_WRITE */
+	ib[n++] = (uint32_t)data_iova;
+	ib[n++] = 0u;
+	ib[n++] = 0x600dbeefu;
+	ib[n++] = gg_pkt7(CP_EVENT_WRITE, 4u);
+	ib[n++] = 0x04u;
+	ib[n++] = (uint32_t)(data_iova + 4u);
+	ib[n++] = 0u;
+	ib[n++] = 0x600df00du;
+	flush_dcache64((addr64_t)ptoa_64(ib_pn), GEM_PAGE, TRUE);
+
+	words = n;
+	fence = gauguin_cp_submit(&ib_iova, &words, 1u);
+	if (fence != 0) {
+		(void)gauguin_cp_wait(fence, 1000000000ULL);
+	}
+	flush_dcache64((addr64_t)ptoa_64(data_pn), GEM_PAGE, TRUE);
+	mw = *(volatile uint32_t *)data_kva;
+	ev = *(volatile uint32_t *)(data_kva + 4u);
+	printf("GAUGUIN GEM: selftest fence=%#x ib=%#x data=%#x"
+	    " memwrite=%#x event=%#x %s\n",
+	    fence, (uint32_t)ib_iova, (uint32_t)data_iova, mw, ev,
+	    (fence != 0 && mw == 0x600dbeefu && ev == 0x600df00du) ?
+	    "PASS" : "FAIL");
+	(void)sweet_log_flush_now();
 }
 
