+/*
+ * 0213: name the packet the ME actually died in. 0191/0191's "at" comes from
+ * CP_IB1_REM_SIZE, which is the ROQ *prefetch* pointer - in v162 it pointed at
+ * copy 2801 (a CP_COND_WRITE that had never been dispatched) while the last
+ * annotation stamp put the execution point at 2505 and the next packet, a
+ * CP_DRAW_INDX_OFFSET at 2510, is what never retired. Decode from the stamp,
+ * label the payload fields that are known for this opcode, and look every
+ * payload dword that falls in the GPU VA range up in the GEM table, so a zero
+ * or unbound base names itself instead of showing up as far=0 later.
+ */
+static void
+gg_pkt_decode(const char *tag, volatile uint32_t *cp, uint32_t at, uint32_t n)
+{
+	uint32_t h, type, op, plen, len, i;
+
+	if (at + 1u >= n) {
+		printf("GAUGUIN CP: 0213 %s none at=%u of=%u\n", tag, at, n);
+		return;
+	}
+	h = cp[at];
+	type = h >> 28u;
+	if (type == 7u) {
+		plen = h & 0x3fffu;
+	} else if (type == 4u) {
+		plen = h & 0x7fu;
+	} else if (type == 0u) {
+		plen = ((h >> 16) & 0x3fffu) + 1u;
+	} else {
+		printf("GAUGUIN CP: 0213 %s at=%u type=%u hdr=%#x\n", tag, at, type,
+		    h);
+		return;
+	}
+	op = (h >> 16) & 0x7fu;
+	len = 1u + plen;
+	if (at + len > n) {
+		len = n - at;
+	}
+	printf("GAUGUIN CP: 0213 %s at=%u of=%u type=%u op=%#x count=%u hdr=%#x\n",
+	    tag, at, n, type, op, plen, h);
+	for (i = 1u; i < len && i <= 12u; i++) {
+		uint32_t v = cp[at + i];
+		const char *lbl = "";
+		uint32_t map = 0u, first = 0u;
+
+		if (type == 7u && op == 0x38u) {
+			lbl = i == 1u ? "index_count/initiator" :
+			    (i == 2u ? "index_offset" :
+			    (i == 3u ? "instance/bias" : ""));
+		} else if (type == 7u && op == 0x45u) {
+			lbl = i == 1u ? "poll_lo" : (i == 2u ? "poll_hi" :
+			    (i == 3u ? "ref" : (i == 4u ? "mask" :
+			    (i == 6u ? "write_lo" : (i == 7u ? "write_hi" :
+			    (i == 8u ? "write_data" : ""))))));
+		}
+		if (v >= 0x40000000u && v < 0x80000000u) {
+			map = gg_gem_pa(v) != 0u || gg_san_map(v) != 0u;
+			first = gg_san_rd2(v, 0, 0, 0u);
+		}
+		printf("GAUGUIN CP: 0213 %s p%u=%#x%s%s%s%s\n", tag, i - 1u, v,
+		    lbl[0] != '\0' ? " " : "", lbl,
+		    v == 0xffffffffu ? " <uninit>" : "",
+		    map != 0u ? " in-gem" : "");
+		if (map != 0u) {
+			printf("GAUGUIN CP: 0213 %s p%u bo[0]=%#x\n", tag, i - 1u,
+			    first);
+		}
+	}
+}
