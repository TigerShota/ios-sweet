+/*
+ * 0205: v152's wedge is either a 3D job that never retires or a write the CP
+ * cannot complete. The two are told apart by whether the address the stream
+ * writes (the CACHE_FLUSH_TS target, in the GEM window) still has a valid
+ * context-bank 1 entry, and whether the page it names is still backed.
+ */
+static void
+gg_iova_probe(const char *tag, uint64_t iova)
+{
+	uint32_t l2i = (uint32_t)((iova >> 21) & 0x1ffu), tbl = 0;
+	uint64_t l2e = (uint64_t)gm_rd32_raw(CPMEM_L2 + 8u * l2i) |
+	    ((uint64_t)gm_rd32_raw(CPMEM_L2 + 8u * l2i + 4u) << 32);
+	uint64_t pte = 0, pa = 0;
+	unsigned pn = 0;
+	bool l2ok;
+
+	l2ok = gg_gem_l2(iova, &tbl);
+	if (l2ok) {
+		pte = *(volatile uint64_t *)(gem_l3 + 0x1000u * tbl +
+		    8u * ((iova >> 12) & 0x1ffu));
+		if ((pte & 3u) != 0u) {
+			pa = pte & 0x0000fffffffff000ULL;
+			pn = (unsigned)pmap_find_phys(kernel_pmap, (addr64_t)pa);
+		}
+	}
+	printf("GAUGUIN CP: 0205 %s iova=%#llx l2e=%#llx l2ok=%d tbl=%u"
+	    " pte=%#llx pa=%#llx pn=%u\n", tag, (unsigned long long)iova,
+	    (unsigned long long)l2e, (int)l2ok,
+	    tbl, (unsigned long long)pte, (unsigned long long)pa, pn);
+}
+
+/* Probe every CACHE_FLUSH_TS target the wedged IB still contains. */
+static void
+gg_ib_evprobe(uint64_t iova, uint32_t dwords)
+{
+	uint32_t o = 0, n = 0;
+
+	while (o + 1u < dwords && n < 4u) {
+		vm_offset_t mp = gg_san_map(iova + 4u * o);
+		uint32_t h, plen;
+
+		if (mp == 0) {
+			break;
+		}
+		h = gg_rd(mp, 0);
+		if ((h >> 28) == 7u) {
+			plen = h & 0x3fffu;
+			if (((h >> 16) & 0x7fu) == CP_EVENT_WRITE && plen >= 3u) {
+				mp = gg_san_map(iova + 4u * (o + 1u));
+				h = mp != 0 ? gg_rd(mp, 0) : 0u;
+				if ((h & 0x3fu) == 0x1du ||
+				    (h & 0x3fu) == 0x1cu) {
+					uint32_t al, ah;
+
+					mp = gg_san_map(iova + 4u * (o + 2u));
+					al = mp != 0 ? gg_rd(mp, 0) : 0u;
+					mp = gg_san_map(iova + 4u * (o + 3u));
+					ah = mp != 0 ? gg_rd(mp, 0) : 0u;
+					gg_iova_probe("ev",
+					    ((uint64_t)ah << 32) | al);
+					n++;
+				}
+			}
+			o += 2u + plen;
+		} else if ((h >> 28) == 4u) {
+			o += 2u;
+		} else {
+			o++;
+		}
+	}
+}
