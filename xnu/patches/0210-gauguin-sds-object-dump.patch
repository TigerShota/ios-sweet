+	    gg_rd(gg.gpu, GR(0x949u)), gg_rd(gg.gpu, GR(0x94au)),
+	    gg_rd(gg.gpu, GR(0x92eu)), gg_rd(gg.gpu, GR(0x930u)),
+	    gg_rd(gg.gpu, GR(0x931u)), gg_rd(gg.gpu, GR(0x933u)),
+	    gg_rd(gg.gpu, GR(0x934u)), gg_rd(gg.gpu, GR(0x947u)),
