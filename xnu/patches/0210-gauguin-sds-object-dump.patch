+			uint32_t v = srd[GG_MARK_BASE / 4u + kk];
+			uint32_t pos = v & 0xffffu;
+
+			if (v == 0u || (mark_mask & (1ull << kk)) == 0u ||
+			    pos == 0u || pos >= wi[kk]) {
+				continue;
+			}
+			printf("GAUGUIN CP: 0210 exec ib=%u pos=%u of=%u\n", kk, pos,
+			    wi[kk]);
+			gg_sds_dump(srd + gg_mark_off[kk] / 4u, pos);
+		}
+	}
