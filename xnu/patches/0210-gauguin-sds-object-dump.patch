 /*
+ * 0210: v157/v158 both stop right after a CP_SET_DRAW_STATE (op 0x43, header
+ * 0x7043802d = 15 groups) - the last stamp the ME wrote names the packet past
+ * it - and RBBM_STATUS then reads 0x800005, i.e. CP_AHB_CX|CP|GPU_BUSY: a CP
+ * register transaction that never completes. The state objects that packet
+ * points at are executed as PM4 by the ME, and gg_ib_sanitize() has never
+ * walked them - it only follows CP_INDIRECT_BUFFER - so a privileged or
+ * absent register write inside one of them reaches the hardware untouched.
+ * Dump the descriptors of the last such packet in the executed prefix and the
+ * head of every object, with type-4 register names, so the wedging register is
+ * in the log instead of being guessed at.
+ */
+static void
+gg_sds_dump(volatile uint32_t *cp, uint32_t upto)
+{
+	uint32_t o = 0u, last = 0u, found = 0u, g, n;
+
+	while (o < upto) {
+		uint32_t h = cp[o];
+		uint32_t type = h >> 28u;
+		uint32_t plen;
+
+		if (type == 7u) {
+			plen = h & 0x3fffu;
+		} else if (type == 4u) {
+			plen = h & 0x7fu;
+		} else if (type == 0u) {
+			plen = ((h >> 16) & 0x3fffu) + 1u;
+		} else {
+			break;
+		}
+		if (o + 1u + plen > upto) {
+			break;
+		}
+		if (type == 7u && ((h >> 16) & 0x7fu) == 0x43u && plen >= 3u) {
+			last = o;
+			found = 1u;
+		}
+		o += 1u + plen;
+	}
+	if (found == 0u) {
+		printf("GAUGUIN CP: 0210 sds none below %u\n", upto);
+		return;
+	}
+	{
+		uint32_t plen = cp[last] & 0x3fffu;
+		uint32_t groups = plen / 3u;
+
+		printf("GAUGUIN CP: 0210 sds at=%u groups=%u\n", last, groups);
+		for (g = 0; g < groups && g < 16u; g++) {
+			uint32_t d0 = cp[last + 1u + 3u * g];
+			uint64_t iova =
+			    ((uint64_t)cp[last + 3u + 3u * g] << 32) |
+			    (uint64_t)cp[last + 2u + 3u * g];
+			uint32_t sz = d0 & 0xffffu;
+			vm_offset_t m = sz != 0u ? gg_san_map(iova) : 0u;
+
+			printf("GAUGUIN CP: 0210 g%u dw=%#x n=%u va=%#llx map=%u\n",
+			    g, d0, sz, (unsigned long long)iova,
+			    m != 0u ? 1u : 0u);
+			if (m == 0u || sz == 0u || sz > 1024u) {
+				continue;
+			}
+			for (n = 0; n < sz && n < 12u; n++) {
+				uint32_t v = gg_san_rd2(iova, m, 0, n);
+				const char *nm = ((v >> 28u) == 4u) ?
+				    gg_reg_name((v >> 8) & 0x7ffffu) : 0;
+
+				printf("GAUGUIN CP: 0210 g%u %u: %#x %s%s\n", g, n,
+				    v, nm != 0 ? "name=" : "",
+				    nm != 0 ? nm : "");
+			}
+		}
+	}
+}
