 /*
+ * 0243: the 0236 scan never printed in v202 (its state machine never reached the
+ * done branch), so the same count is now also taken at arm time, which cannot be
+ * skipped: arm #2..N runs after the previous paint has had a whole submission to
+ * retire.
+ */
+static void
+gg_probe_scan_scratch(const char *tag, uint32_t at)
+{
+	vm_offset_t m = ml_io_map(cp_pa + CPMEM_SCRATCH + 0x2000u,
+	    GG_PROBE_SCAN);
+	uint32_t k, nz = 0u, first = 0u, fv = 0u;
+
+	if (m != 0) {
+		for (k = 0u; k < GG_PROBE_SCAN / 4u; k++) {
+			uint32_t v = *(volatile uint32_t *)(m + k * 4u);
+
+			if (v != 0u) {
+				if (nz == 0u) {
+					first = k * 4u;
+					fv = v;
+				}
+				nz++;
+			}
+		}
+	}
+	printf("GAUGUIN CP: 0243 scan %s at=%u nz=%u first=%#x val=%#x\n",
+	    tag, at, nz, first, fv);
+	(void)sweet_log_flush_now();
+}
