+/*
+ * 0159: same block/head write as sweet_log_flush_now(), but callable from
+ * panic context: no mutex (the panic CPU may already hold sweet_ufs_lock),
+ * no printf (a failing UFS command prints, which would re-enter append and
+ * recurse), and a busy/done guard. ufs_scsi() is polled - it rings the
+ * doorbell and spins on UTRLDBR with delay(1) - so it works with interrupts
+ * disabled. Duplicated block writes are harmless.
+ */
+static void
+sweet_log_panic_flush(void)
+{
+	uint64_t base, total, pos;
+	void *bounce;
+	int error = 0;
+
+	if (!sweet_log_ready || sweet_panic_done || sweet_panic_busy) {
+		return;
+	}
+	sweet_panic_busy = 1;
+	total = os_atomic_load(&sweet_log_total, relaxed);
+	if (total == sweet_log_forced) {
+		sweet_panic_busy = 0;
+		return;
+	}
+	base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
+	bounce = (void *)(su.dma + DMA_BOUNCE);
+	pos = sweet_log_forced;
+	while (pos < total && !error) {
+		uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
+		uint32_t blk = off / UFS_BLOCK;
+		uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
+		uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(SWEET_LOG_SIZE / UFS_BLOCK - blk)),
+		    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
+		memcpy(bounce, sweet_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+		error = ufs_write_blocks(base + 1 + blk, n);
+		pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
+	}
+	if (!error) {
+		struct sweet_log_header h = {
+			.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+			.version = 1, .size = SWEET_LOG_SIZE, .total = total,
+			.seq = 0,
+		};
+		bzero(bounce, UFS_BLOCK);
+		memcpy(bounce, &h, sizeof(h));
+		error = ufs_write_blocks(base, 1);
+	}
+	if (!error) {
+		error = ufs_sync_cache();
+	}
+	if (error) {
+		sweet_panic_done = 1;   /* never retry; UFS already printed why */
+	} else {
+		sweet_log_forced = total;
+	}
+	sweet_panic_busy = 0;
+}
