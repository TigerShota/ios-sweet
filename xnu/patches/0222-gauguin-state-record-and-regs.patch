+/*
+ * 0222: the draw's hardware inputs, read while the CP is still healthy (the
+ * first ~280 submits retire). 0213's version sat on the hang path, which 0216
+ * made memory-only, so RB_MRT/DB and the SP/VFD words have never been observed.
+ * One register per line after a label, so a read that hangs still names itself.
+ */
+static int gg_reg_dumps;
+
+static void
+gg_draw_regs(uint32_t fence)
+{
+	static const struct {
+		uint32_t off;
+		const char *name;
+	} regs[] = {
+		{ 0x8801u, "RB_RENDER_CNTL" },
+		{ 0x8820u, "RB_MRT0_CONTROL" },
+		{ 0x8822u, "RB_MRT0_INFO" },
+		{ 0x8823u, "RB_MRT0_PITCH" },
+		{ 0x8825u, "RB_MRT0_BASE_LO" },
+		{ 0x8826u, "RB_MRT0_BASE_HI" },
+		{ 0x8871u, "RB_DEPTH_CNTL" },
+		{ 0x8875u, "RB_DEPTH_BASE_LO" },
+		{ 0xa000u, "VFD_0000" },
+		{ 0xa006u, "VFD_FETCH_INSTR_0" },
+		{ 0xa007u, "VFD_FETCH_INSTR_1" },
+		{ 0xa00eu, "VFD_INDEX_OFFSET" },
+		{ 0xa00fu, "VFD_INDEX_MAX" },
+		{ 0xa090u, "VFD_0090" },
+		{ 0xa800u, "SP_VS_CTRL_REG0" },
+		{ 0xa824u, "SP_VS_CTRL_REG1" },
+		{ 0xa980u, "SP_FS_CTRL_REG0" },
+	};
+	uint32_t i;
+
+	printf("GAUGUIN CP: 0222 regs fence=%#x\n", fence);
+	for (i = 0; i < sizeof(regs) / sizeof(regs[0]); i++) {
+		printf("GAUGUIN CP: 0222 reg %s=%#x\n", regs[i].name,
+		    gg_rd(gg.gpu, GR(regs[i].off)));
+	}
+	(void)sweet_log_flush_now();
+}
