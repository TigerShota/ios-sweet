+				adv = cnt + 1u;
+			} else if (type == 4u) {
+				op = 0x1000u + ((h >> 8) & 0x3ffffu);
+				adv = 2u + ((h >> 16) & 3u);
+				cnt = adv;
 			} else {
-				printf("GAUGUIN CP: 0253 end type=%u h=%#x"
