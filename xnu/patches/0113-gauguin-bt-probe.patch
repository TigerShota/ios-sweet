@@ -0,0 +1,368 @@
+/*
+ * gauguin (SM7150/sweet) Bluetooth step 1: look at QUPv3_0 SE1, the GENI
+ * UART the WCN3990 is wired to, and at the GCC branch votes and TLMM pins
+ * that gate it. Nothing is transmitted and no pin or rail is touched.
+ *
+ * The facts come from this device, not from a sibling port:
+ *  - DT /soc/qcom,qup_uart@884000, compatible "qcom,msm-geni-serial-hs",
+ *    reg 0x884000+0x4000 (SE1 of /soc/qcom,qupv3_0_geni_se@8c0000,
+ *    qcom,wrapper-core phandle 0xf5), wakeup-byte 0xfd, pinctrl-0/1/2 =
+ *    phandles 0xf7,0xf8 / 0xf9,0xfa,0xfb, status "ok".
+ *  - gcc-lagoon.c: gcc_qupv3_wrap0_s1_clk halt 0x21274, vote 0x52000 bit 11,
+ *    RCG cmd_rcgr 0x21278; wrap_0_m_ahb halt 0x21004 (vote bit 6),
+ *    wrap_0_s_ahb halt 0x21008 (bit 7), wrap0_core halt 0x2100c (bit 8),
+ *    wrap0_core_2x halt 0x21014 (bit 9).
+ *  - pinctrl-lagoon.c: ctl_reg = 0x1000 * id from TLMM 0xf100000; pins
+ *    61/62/63/64 are function qup01 (CTS 61, RTS 62, TX 63, RX 64 - the DT
+ *    default group lists 61,62,64 and the tx group 63). BT power enable is
+ *    gpio 69 (qca,bt-sw-ctrl-gpio = <&pinctrl 69 0>, active high).
+ *
+ * An SE register file cannot be read while its AHB clock is off, so the
+ * cold GCC state is printed first and the five QUPv3_0 branches are voted
+ * only when needed (gauguinbtclk=0 disables even that). No SE register is
+ * written: this patch only measures.
+ *
+ * Boot-args: gauguinbt=0/1 (default 1), gauguinbtdelay=<seconds> (default
+ * 45, after the GPU thread's 30), gauguinbtclk=0/1 (default 1).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <vm/vm_kern.h>
+#include <vm/pmap.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_log_flush_now(void);
+
+/* Physical windows, all from this device's DT. */
+#define BT_GCC_PA      0x00100000u   /* qcom,gcc@100000 */
+#define BT_GCC_SIZE    0x60000u
+#define BT_QUP0_PA     0x008c0000u   /* qcom,qupv3_0_geni_se@8c0000 */
+#define BT_QUP0_SIZE   0x1000u
+#define BT_SE1_PA      0x00884000u   /* qcom,qup_uart@884000 */
+#define BT_SE1_SIZE    0x4000u
+#define BT_TLMM_PA     0x0f100000u   /* pinctrl@f100000 */
+#define BT_TLMM_SIZE   0x50000u      /* covers pins 61..69, 0x1000 each */
+#define BT_PIN_STRIDE  0x1000u
+
+/* GCC (gcc-lagoon.c). */
+#define GCC_QUPV3_WRAP0_VOTE 0x52000u
+#define GCC_WRAP0_M_AHB      0x21004u
+#define GCC_WRAP0_S_AHB      0x21008u
+#define GCC_WRAP0_CORE       0x2100cu
+#define GCC_WRAP0_CORE_2X    0x21014u
+#define GCC_WRAP0_SE1        0x21274u  /* gcc_qupv3_wrap0_s1_clk */
+#define GCC_WRAP0_SE1_RCG    0x21278u  /* cmd_rcgr; +4 cfg, +8 m, +0xc n, +0x10 d */
+#define GCC_HALT_BIT         (1u << 31)
+#define GCC_HWCG_BIT         (1u << 1) /* CBCR hardware gating: counts as running */
+#define GCC_VOTE_M_AHB       (1u << 6)
+#define GCC_VOTE_S_AHB       (1u << 7)
+#define GCC_VOTE_CORE        (1u << 8)
+#define GCC_VOTE_CORE_2X     (1u << 9)
+#define GCC_VOTE_SE1         (1u << 11)
+#define GCC_CMD_ROOT_OFF     (1u << 31)
+#define GCC_CFG_SRC_MASK     (0x7u << 8)
+#define GCC_CFG_SRC_SHIFT    8
+#define GCC_CFG_DIV_MASK     0x1fu
+
+/* QUP wrapper and GENI SE (qcom-geni-se.h). */
+#define QUPV3_HW_VER           0x004u
+#define SE_GENI_STATUS         0x040u
+#define GENI_SER_M_CLK_CFG     0x048u
+#define GENI_SER_S_CLK_CFG     0x04cu
+#define GENI_IF_DISABLE_RO     0x064u
+#define GENI_FW_REVISION_RO    0x068u
+#define SE_GENI_DMA_MODE_EN    0x258u
+#define SE_GENI_M_CMD0         0x600u
+#define SE_GENI_M_IRQ_STATUS   0x610u
+#define SE_GENI_M_IRQ_EN       0x614u
+#define SE_GENI_S_CMD0         0x630u
+#define SE_GENI_S_IRQ_STATUS   0x640u
+#define SE_GENI_S_IRQ_EN       0x644u
+#define SE_GENI_TX_FIFO_STATUS 0x800u
+#define SE_GENI_RX_FIFO_STATUS 0x804u
+#define SE_IRQ_EN              0xe1cu
+#define SE_HW_PARAM_0          0xe24u
+#define SE_HW_PARAM_1          0xe28u
+#define SE_STATUS_M_ACTIVE     (1u << 0)
+#define SE_STATUS_S_ACTIVE     (1u << 12)
+#define FW_REV_PROTOCOL_MASK   0xff00u
+#define FW_REV_PROTOCOL_SHIFT  8
+#define FW_REV_VERSION_MASK    0xffu
+#define SE_PROTO_UART          2u
+
+/* TLMM pin config (pinctrl-lagoon.c and msm_pinctrl semantics). */
+#define TLMM_FUNC_MASK  0x3cu
+#define TLMM_FUNC_SHIFT 2
+#define TLMM_PULL_MASK  0x3u
+#define TLMM_DRV_MASK   0x1c0u
+#define TLMM_DRV_SHIFT  6
+#define TLMM_OE_BIT     (1u << 9)
+#define TLMM_IO_OFF     0x4u
+#define TLMM_IN_BIT     (1u << 0)
+#define TLMM_OUT_BIT    (1u << 1)
+
+#define BT_PIN_CTS 61u
+#define BT_PIN_RTS 62u
+#define BT_PIN_TX  63u
+#define BT_PIN_RX  64u
+#define BT_PIN_EN  69u
+
+static struct {
+	vm_offset_t gcc, qup, se, tlmm;
+	bool started;
+} bt;
+static int bt_sleep_chan;
+
+static uint32_t
+bt_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+bt_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+bt_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&bt_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+bt_branch_on(uint32_t v)
+{
+	return !(v & GCC_HALT_BIT);
+}
+
+/* s_ahb and m_ahb carry a hardware-gating bit: gated still counts as running. */
+static bool
+bt_branch_on_gated(uint32_t v)
+{
+	return !(v & GCC_HALT_BIT) || (v & GCC_HWCG_BIT);
+}
+
+static const char *
+bt_protocol(uint32_t p)
+{
+	switch (p) {
+	case 0: return "none";
+	case 1: return "SPI";
+	case 2: return "UART";
+	case 3: return "I2C";
+	case 4: return "I3C";
+	default: return "unknown";
+	}
+}
+
+static void
+bt_dump_pin(uint32_t pin)
+{
+	uint32_t cfg = bt_rd(bt.tlmm, BT_PIN_STRIDE * pin);
+	uint32_t io = bt_rd(bt.tlmm, BT_PIN_STRIDE * pin + TLMM_IO_OFF);
+
+	printf("GAUGUIN BT: pin %u cfg=%#x func=%u pull=%u drive=%u oe=%u io=%#x in=%u out=%u\n",
+	    pin, cfg, (cfg & TLMM_FUNC_MASK) >> TLMM_FUNC_SHIFT, cfg & TLMM_PULL_MASK,
+	    (cfg & TLMM_DRV_MASK) >> TLMM_DRV_SHIFT, (cfg & TLMM_OE_BIT) ? 1u : 0u, io,
+	    (io & TLMM_IN_BIT) ? 1u : 0u, (io & TLMM_OUT_BIT) ? 1u : 0u);
+}
+
+static void
+bt_dump_se(void)
+{
+	uint32_t fw, status, mclk, sclk, ifdis, dma, mcmd, mirq, men, scmd, sirq, sen;
+	uint32_t txf, rxf, irqen, hw0, hw1;
+
+	if (!bt.qup) {
+		bt.qup = ml_io_map(BT_QUP0_PA, BT_QUP0_SIZE);
+	}
+	if (bt.qup) {
+		printf("GAUGUIN BT: qup0 QUPV3_HW_VER=%#x\n", bt_rd(bt.qup, QUPV3_HW_VER));
+	} else {
+		printf("GAUGUIN BT: qup0 wrapper map failed\n");
+	}
+	if (!bt.se) {
+		bt.se = ml_io_map(BT_SE1_PA, BT_SE1_SIZE);
+	}
+	if (!bt.se) {
+		printf("GAUGUIN BT: se1 map failed\n");
+		return;
+	}
+
+	status = bt_rd(bt.se, SE_GENI_STATUS);
+	fw = bt_rd(bt.se, GENI_FW_REVISION_RO);
+	mclk = bt_rd(bt.se, GENI_SER_M_CLK_CFG);
+	sclk = bt_rd(bt.se, GENI_SER_S_CLK_CFG);
+	ifdis = bt_rd(bt.se, GENI_IF_DISABLE_RO);
+	dma = bt_rd(bt.se, SE_GENI_DMA_MODE_EN);
+	mcmd = bt_rd(bt.se, SE_GENI_M_CMD0);
+	mirq = bt_rd(bt.se, SE_GENI_M_IRQ_STATUS);
+	men = bt_rd(bt.se, SE_GENI_M_IRQ_EN);
+	scmd = bt_rd(bt.se, SE_GENI_S_CMD0);
+	sirq = bt_rd(bt.se, SE_GENI_S_IRQ_STATUS);
+	sen = bt_rd(bt.se, SE_GENI_S_IRQ_EN);
+	txf = bt_rd(bt.se, SE_GENI_TX_FIFO_STATUS);
+	rxf = bt_rd(bt.se, SE_GENI_RX_FIFO_STATUS);
+	irqen = bt_rd(bt.se, SE_IRQ_EN);
+	hw0 = bt_rd(bt.se, SE_HW_PARAM_0);
+	hw1 = bt_rd(bt.se, SE_HW_PARAM_1);
+
+	printf("GAUGUIN BT: se1 fw=%#x (protocol %u = %s, version %#x) status=%#x"
+	    " (m_active=%u s_active=%u)\n", fw,
+	    (fw & FW_REV_PROTOCOL_MASK) >> FW_REV_PROTOCOL_SHIFT,
+	    bt_protocol((fw & FW_REV_PROTOCOL_MASK) >> FW_REV_PROTOCOL_SHIFT),
+	    fw & FW_REV_VERSION_MASK, status,
+	    (status & SE_STATUS_M_ACTIVE) ? 1u : 0u, (status & SE_STATUS_S_ACTIVE) ? 1u : 0u);
+	printf("GAUGUIN BT: se1 is loaded as UART: %s\n",
+	    ((fw & FW_REV_PROTOCOL_MASK) >> FW_REV_PROTOCOL_SHIFT) == SE_PROTO_UART ? "YES" : "NO");
+	printf("GAUGUIN BT: se1 ser_m_clk_cfg=%#x ser_s_clk_cfg=%#x if_disable=%#x dma_mode=%#x\n",
+	    mclk, sclk, ifdis, dma);
+	printf("GAUGUIN BT: se1 m_cmd0=%#x m_irq=%#x/%#x s_cmd0=%#x s_irq=%#x/%#x irq_en=%#x\n",
+	    mcmd, mirq, men, scmd, sirq, sen, irqen);
+	printf("GAUGUIN BT: se1 tx_fifo=%#x rx_fifo=%#x hw0=%#x hw1=%#x\n",
+	    txf, rxf, hw0, hw1);
+	(void)sweet_log_flush_now();
+}
+
+static void
+bt_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 45;
+	int clk_en = 1;
+	uint32_t vote, m_ahb, s_ahb, core, core2x, se1, cmd, cfg, m, n, d;
+	bool ahb_on;
+	(void)arg;
+	(void)result;
+
+	(void)PE_parse_boot_argn("gauguinbtdelay", &delay_s, sizeof(delay_s));
+	(void)PE_parse_boot_argn("gauguinbtclk", &clk_en, sizeof(clk_en));
+	printf("GAUGUIN BT: probe starting in %u s\n", delay_s);
+	bt_wait(delay_s * 1000u);
+
+	bt.gcc = ml_io_map(BT_GCC_PA, BT_GCC_SIZE);
+	bt.tlmm = ml_io_map(BT_TLMM_PA, BT_TLMM_SIZE);
+	printf("GAUGUIN BT: gcc mapped=%d tlmm mapped=%d\n", bt.gcc ? 1 : 0, bt.tlmm ? 1 : 0);
+	(void)sweet_log_flush_now();
+	if (!bt.gcc || !bt.tlmm) {
+		return;
+	}
+
+	/* Cold state: the vote word and every branch that gates the SE. */
+	vote = bt_rd(bt.gcc, GCC_QUPV3_WRAP0_VOTE);
+	m_ahb = bt_rd(bt.gcc, GCC_WRAP0_M_AHB);
+	s_ahb = bt_rd(bt.gcc, GCC_WRAP0_S_AHB);
+	core = bt_rd(bt.gcc, GCC_WRAP0_CORE);
+	core2x = bt_rd(bt.gcc, GCC_WRAP0_CORE_2X);
+	se1 = bt_rd(bt.gcc, GCC_WRAP0_SE1);
+	printf("GAUGUIN BT: cold vote=%#x (m_ahb=%u s_ahb=%u core=%u core2x=%u se1=%u)\n",
+	    vote, (vote & GCC_VOTE_M_AHB) ? 1u : 0u, (vote & GCC_VOTE_S_AHB) ? 1u : 0u,
+	    (vote & GCC_VOTE_CORE) ? 1u : 0u, (vote & GCC_VOTE_CORE_2X) ? 1u : 0u,
+	    (vote & GCC_VOTE_SE1) ? 1u : 0u);
+	printf("GAUGUIN BT: cold m_ahb=%#x(%u) s_ahb=%#x(%u) core=%#x(%u) core2x=%#x(%u) se1=%#x(%u)\n",
+	    m_ahb, bt_branch_on(m_ahb) ? 1u : 0u, s_ahb, bt_branch_on_gated(s_ahb) ? 1u : 0u,
+	    core, bt_branch_on(core) ? 1u : 0u, core2x, bt_branch_on(core2x) ? 1u : 0u,
+	    se1, bt_branch_on(se1) ? 1u : 0u);
+	cmd = bt_rd(bt.gcc, GCC_WRAP0_SE1_RCG);
+	cfg = bt_rd(bt.gcc, GCC_WRAP0_SE1_RCG + 0x4u);
+	m = bt_rd(bt.gcc, GCC_WRAP0_SE1_RCG + 0x8u);
+	n = bt_rd(bt.gcc, GCC_WRAP0_SE1_RCG + 0xcu);
+	d = bt_rd(bt.gcc, GCC_WRAP0_SE1_RCG + 0x10u);
+	printf("GAUGUIN BT: cold se1 rcg cmd=%#x (%s) cfg=%#x src=%u div=%u m=%#x n=%#x d=%#x\n",
+	    cmd, (cmd & GCC_CMD_ROOT_OFF) ? "root off" : "root on", cfg,
+	    (cfg & GCC_CFG_SRC_MASK) >> GCC_CFG_SRC_SHIFT, cfg & GCC_CFG_DIV_MASK, m, n, d);
+	(void)sweet_log_flush_now();
+
+	bt_dump_pin(BT_PIN_CTS);
+	bt_dump_pin(BT_PIN_RTS);
+	bt_dump_pin(BT_PIN_TX);
+	bt_dump_pin(BT_PIN_RX);
+	bt_dump_pin(BT_PIN_EN);
+	(void)sweet_log_flush_now();
+
+	ahb_on = bt_branch_on(m_ahb) && bt_branch_on_gated(s_ahb);
+	if (!ahb_on && clk_en) {
+		uint32_t want = vote | GCC_VOTE_M_AHB | GCC_VOTE_S_AHB | GCC_VOTE_CORE |
+		    GCC_VOTE_CORE_2X | GCC_VOTE_SE1;
+		printf("GAUGUIN BT: wrapping up qup0 AHB votes\n");
+		(void)sweet_log_flush_now();
+		bt_wr(bt.gcc, GCC_QUPV3_WRAP0_VOTE, want);
+		for (unsigned i = 0; i < 100; ++i) {
+			bt_wait(1);
+			if (bt_branch_on(bt_rd(bt.gcc, GCC_WRAP0_M_AHB)) &&
+			    bt_branch_on_gated(bt_rd(bt.gcc, GCC_WRAP0_S_AHB))) {
+				break;
+			}
+		}
+		vote = bt_rd(bt.gcc, GCC_QUPV3_WRAP0_VOTE);
+		m_ahb = bt_rd(bt.gcc, GCC_WRAP0_M_AHB);
+		s_ahb = bt_rd(bt.gcc, GCC_WRAP0_S_AHB);
+		core = bt_rd(bt.gcc, GCC_WRAP0_CORE);
+		core2x = bt_rd(bt.gcc, GCC_WRAP0_CORE_2X);
+		se1 = bt_rd(bt.gcc, GCC_WRAP0_SE1);
+		printf("GAUGUIN BT: hot vote=%#x m_ahb=%#x s_ahb=%#x core=%#x core2x=%#x se1=%#x\n",
+		    vote, m_ahb, s_ahb, core, core2x, se1);
+		(void)sweet_log_flush_now();
+		ahb_on = bt_branch_on(m_ahb) && bt_branch_on_gated(s_ahb);
+	}
+
+	if (!ahb_on) {
+		printf("GAUGUIN BT: qup0 AHB is off (m_ahb=%#x s_ahb=%#x): SE1 not read\n",
+		    m_ahb, s_ahb);
+		(void)sweet_log_flush_now();
+		return;
+	}
+
+	printf("GAUGUIN BT: qup0 AHB on - reading SE1\n");
+	(void)sweet_log_flush_now();
+	bt_dump_se();
+
+	cmd = bt_rd(bt.gcc, GCC_WRAP0_SE1_RCG);
+	cfg = bt_rd(bt.gcc, GCC_WRAP0_SE1_RCG + 0x4u);
+	m = bt_rd(bt.gcc, GCC_WRAP0_SE1_RCG + 0x8u);
+	n = bt_rd(bt.gcc, GCC_WRAP0_SE1_RCG + 0xcu);
+	d = bt_rd(bt.gcc, GCC_WRAP0_SE1_RCG + 0x10u);
+	printf("GAUGUIN BT: hot se1 rcg cmd=%#x (%s) cfg=%#x src=%u div=%u m=%#x n=%#x d=%#x\n",
+	    cmd, (cmd & GCC_CMD_ROOT_OFF) ? "root off" : "root on", cfg,
+	    (cfg & GCC_CFG_SRC_MASK) >> GCC_CFG_SRC_SHIFT, cfg & GCC_CFG_DIV_MASK, m, n, d);
+	printf("GAUGUIN BT: step 1 done - SE1 state measured, no register written in the SE\n");
+	(void)sweet_log_flush_now();
+}
+
+void
+gauguin_bt_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+
+	if (bt.started) {
+		return;
+	}
+	bt.started = true;
+	(void)PE_parse_boot_argn("gauguinbt", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("GAUGUIN BT: disabled (gauguinbt=0)\n");
+		return;
+	}
+	kern_return_t kr = kernel_thread_start(bt_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("GAUGUIN BT: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
