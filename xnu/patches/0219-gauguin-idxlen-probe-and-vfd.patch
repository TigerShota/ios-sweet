+/*
+ * 0219: v171 killed the address theory (five index bases, all inside their own
+ * allocation, `OUTSIDE` 0) and left one question: is payload[6] a count or a
+ * byte length? `nullidx=2` zeroed it and the wedge vanished, but "0 indices" and
+ * "0 bytes fetched" both explain that. gauguinidxlen=N rewrites payload[6] to a
+ * small non-zero value while leaving payload[3] alone, which separates the two:
+ * a 64-index/128-byte fetch either retires (the size was the problem) or hangs
+ * (any non-zero fetch is the problem).
+ */
+static int gg_idxlen_opt = -2;
+
+static int
+gg_idxlen(void)
+{
+	if (gg_idxlen_opt == -2) {
+		int v = -1;
+
+		gg_idxlen_opt = PE_parse_boot_argn("gauguinidxlen", &v,
+		    sizeof(v)) ? v : -1;
+	}
+	return gg_idxlen_opt;
+}
+
