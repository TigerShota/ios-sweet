--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -126,10 +126,25 @@
 void
 sweet_early_relocate(uint64_t base)
 {
 	sweet_early_mark(8, "leaving bootstrap TTBR0");
-	early_fb = (volatile uint32_t *)(uintptr_t)base;
+	/*
+	 * gauguin diagnostics: probe the final-VA framebuffer mapping while
+	 * the bootstrap VA=PA alias still works. A white 192x32 band painted
+	 * through the new VA proves the L2 insert translates; if the boot
+	 * dies here the band is missing and EARLY 8 is the last text line.
+	 * After the switch, the second mark 9 proves writes through it.
+	 */
+	volatile uint32_t *nv = (volatile uint32_t *)(uintptr_t)base;
+	for (unsigned int y = 0; y < 32u; y++) {
+		for (unsigned int x = 0; x < 192u; x++) {
+			nv[y * EARLY_STRIDE + x] = 0xffffffffu;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	sweet_early_mark(9, "new VA probed, switching");
+	early_fb = nv;
 	__asm__ volatile("dsb sy" ::: "memory");
 	sweet_early_mark(9, "kernel framebuffer VA live");
 }
