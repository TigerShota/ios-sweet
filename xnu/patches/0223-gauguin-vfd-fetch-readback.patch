+/*
+ * 0223: v175 read 0xa006/0xa007/0xa00f and called them VFD_FETCH_INSTR_0/1 and
+ * VFD_INDEX_MAX, but an a6xx has no such registers: 0xa006/0xa007 are
+ * VFD_CONTROL_6/VFD_MODE_CNTL and 0xa00f is VFD_INSTANCE_START_OFFSET, so "the
+ * vertex fetch descriptors are all zero" was never actually measured. The real
+ * fetch state is VFD_FETCH[0..2] at 0xa010 (BASE lo/hi, SIZE, STRIDE) plus
+ * VFD_DECODE[0..2] at 0xa090 (INSTR, STEP_RATE), and VFD_CONTROL_0 = 0x303 says
+ * three of each are in use. VFD_DECODE[0].INSTR selects fetch buffer 1; if
+ * VFD_FETCH[1].BASE is 0 the VFD reads vertex data from GPU VA 0 and waits for
+ * a translation that never comes, which is exactly the "any non-zero index
+ * count wedges, zero retires" pattern. gauguinfetchbind=1 points every fetch
+ * buffer whose BASE reads 0 at the draw's own index buffer (a GEM VA the CP has
+ * already translated), so a wedge that disappears names the unbound fetch.
+ */
+static int gg_fetchbind_opt = -2;
+static int gg_fetchbind_log;
+
+static int
+gg_fetchbind(void)
+{
+	if (gg_fetchbind_opt == -2) {
+		int v = 0;
+		int got = PE_parse_boot_argn("gauguinfetchbind", &v, sizeof(v));
+
+		gg_fetchbind_opt = got ? v : 0;
+		printf("GAUGUIN CP: 0223 fetchbind parse got=%d val=%d\n", got,
+		    gg_fetchbind_opt);
+	}
+	return gg_fetchbind_opt;
 }
 
