+/*
+ * 0223: insert `nw` one-register type-4 writes (w holds reg/value pairs) in
+ * front of the `len`-dword packet that was just copied to out[*np - len], by
+ * moving that packet up. Every other offset in the copy is unchanged, so the
+ * annotation stamps still name the same positions.
+ */
+#define GG_INS_MAX 8u
+
+static int
+gg_ins(volatile uint32_t *out, uint32_t *np, uint32_t len, const uint32_t *w,
+    uint32_t nw)
+{
+	uint32_t save[GG_INS_MAX], base, k;
+
+	if (len > GG_INS_MAX) {
+		return 0;
+	}
+	base = *np - len;
+	for (k = 0; k < len; ++k) {
+		save[k] = out[base + k];
+	}
+	*np = base;
+	for (k = 0; k < nw; ++k) {
+		out[(*np)++] = gg_pkt4(w[2u * k]);
+		out[(*np)++] = w[2u * k + 1u];
+	}
+	for (k = 0; k < len; ++k) {
+		out[(*np)++] = save[k];
+	}
+	return 1;
+}
