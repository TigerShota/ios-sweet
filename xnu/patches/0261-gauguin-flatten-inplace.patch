@@ -4748,6 +4748,56 @@
 static int gg_copy_warn;
 static int gg_gemib_opt = -1;	/* 0260: gauguingemib=1 - copy into a GEM page */
 static uint32_t gg_gem_slot;	/* 0260: sequential slots, reset per depth-0 IB */
+/*
+ * 0261: gauguinflatib=1 splices each depth-0 indirect's sanitised target into
+ * the outer IB in place (v218 proved the outer stream retires; v222/v223 proved
+ * every placement of the packet itself wedges), and the ring packet's size
+ * dword is overridden from this table so the CP fetches the grown stream.
+ */
+#define GG_SPLICE_IB 8
+#define GG_FLAT_IBS 24
+static int gg_flatib_opt = -1;
+struct gg_splice_s {
+	uint32_t o, tgt, n;
+};
+static struct gg_splice_s gg_splice[GG_SPLICE_IB];
+static uint32_t gg_splice_n;
+static struct {
+	uint32_t va, len, gen;
+} gg_flatib_tab[GG_FLAT_IBS];
+static uint32_t gg_flatib_n, gg_flatib_gen;
+
+static void
+gg_flatib_note(uint32_t va, uint32_t len)
+{
+	uint32_t i;
+
+	for (i = 0u; i < GG_FLAT_IBS; i++) {
+		if (gg_flatib_tab[i].va == va &&
+		    gg_flatib_tab[i].gen == gg_flatib_gen) {
+			gg_flatib_tab[i].len = len;
+			return;
+		}
+	}
+	gg_flatib_tab[gg_flatib_n % GG_FLAT_IBS].va = va;
+	gg_flatib_tab[gg_flatib_n % GG_FLAT_IBS].len = len;
+	gg_flatib_tab[gg_flatib_n % GG_FLAT_IBS].gen = gg_flatib_gen;
+	gg_flatib_n++;
+}
+
+static uint32_t
+gg_flatib_len(uint32_t va)
+{
+	uint32_t i;
+
+	for (i = 0u; i < GG_FLAT_IBS; i++) {
+		if (gg_flatib_tab[i].va == va &&
+		    gg_flatib_tab[i].gen == gg_flatib_gen) {
+			return gg_flatib_tab[i].len;
+		}
+	}
+	return 0u;
+}
 static int gg_fclr_opt = -1;	/* 0198: gauguinfclr=1: all-ones W1C */
 static uint32_t gg_mark_off[GG_MARK_IBS];	/* 0187: copy offset, bytes */
 static uint32_t gg_mark_len[GG_MARK_IBS];	/* 0187: copy length, dwords */
