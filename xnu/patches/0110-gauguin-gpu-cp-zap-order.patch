 /*
+ * The SQE's own view. v30's CP_INTERRUPT_STATUS latched
+ * A6XX_CP_INT_CP_ILLEGAL_INSTR_ERROR (0x80) with no fetch at all, so the
+ * ring and the SMMU are the wrong places to look. These are the
+ * registers mainline's opcode-error path reads (a6xx_cp_hw_err_irq
+ * writes CP_SQE_STAT_ADDR=1 and reads CP_SQE_STAT_DATA for the opcode);
+ * the ucode port reports the SQE's own PC/state and the ROQ port the
+ * queue counters - all AHB reads, no memory visibility involved.
+ */
+static void
+gauguin_cp_dbg_dump(const char *tag)
+{
+	unsigned i;
+
+	printf("GAUGUIN CP: %s status1=%#x intr=%#x rbbm=%#x\n", tag,
+	    gg_rd(gg.gpu, GR(CP_STATUS_1_DW)),
+	    gg_rd(gg.gpu, GR(CP_INTERRUPT_STATUS_DW)),
+	    gg_rd(gg.gpu, GR(A6XX_RBBM_STATUS_DW)));
+	printf("GAUGUIN CP: %s rb cntl=%#x base=%#x sqe=%#x\n", tag,
+	    gg_rd(gg.gpu, GR(CP_RB_CNTL_DW)),
+	    gg_rd(gg.gpu, GR(CP_RB_BASE_DW)),
+	    gg_rd(gg.gpu, GR(CP_SQE_INSTR_BASE_DW)));
+	(void)sweet_log_flush_now();
+	for (i = 0; i < 4; ++i) {
+		gg_wr(gg.gpu, GR(CP_SQE_STAT_ADDR_DW), i);
+		printf("GAUGUIN CP: %s sqe_stat[%u]=%#x\n", tag, i,
+		    gg_rd(gg.gpu, GR(CP_SQE_STAT_DATA_DW)));
+	}
+	for (i = 0; i < 4; ++i) {
+		gg_wr(gg.gpu, GR(CP_SQE_UCODE_DBG_ADDR_DW), i);
+		printf("GAUGUIN CP: %s ucode[%u]=%#x\n", tag, i,
+		    gg_rd(gg.gpu, GR(CP_SQE_UCODE_DBG_DATA_DW)));
+	}
+	for (i = 0; i < 4; ++i) {
+		gg_wr(gg.gpu, GR(CP_ROQ_DBG_ADDR_DW), i);
+		printf("GAUGUIN CP: %s roq_dbg[%u]=%#x\n", tag, i,
+		    gg_rd(gg.gpu, GR(CP_ROQ_DBG_DATA_DW)));
+	}
+	(void)sweet_log_flush_now();
+}
