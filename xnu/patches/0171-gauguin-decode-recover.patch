+		gg_rec_left = PE_parse_boot_argn("gauguinrec", &rec,
+		    sizeof(rec)) ? rec : 2;
+	}
+	if (gg_rec_left > 0 &&
+	    __sync_bool_compare_and_swap(&gg_rec_busy, 0, 1)) {
+		gg_rec_left--;
+		printf("GAUGUIN CP: 0171 recover begin (left=%d)\n",
+		    gg_rec_left);
+		(void)sweet_log_flush_now();
+		if (gauguin_cp_recover()) {
+			printf("GAUGUIN CP: 0171 recover ok - CP restarted\n");
+		} else {
+			/*
+			 * Restart failed: reject further submits instead of
+			 * wedging every caller with -60.
+			 */
+			cp_started = false;
+		}
+		gg_rec_busy = 0;
+		(void)sweet_log_flush_now();
+	}
 	return 0;
 }
 
