 /*
+ * 0171: CP soft-reset recovery. v118 proved the ME dies in the first real
+ * backboardd submit (AHB stall in the nested amble IB, the ROQ holding its
+ * head dwords) and stays dead: every later submit hits the same STUCK with
+ * rptr caught up and scratch2 frozen at the previous fence, so backboardd
+ * sees -60 forever and the desktop never renders. The zap (PAS 13
+ * AUTH_AND_RESET) puts the whole core back to reset - the same mechanism the
+ * boot used - so re-run the minimal bring-up chain (GPU_SET, core clock,
+ * hw_init, secvid/addr-modes, RB regs, zap, SQE release, ME_INIT,
+ * SET_SECURE_MODE, memwrite probe) and let backboardd retry on a fresh CP.
+ * Deliberately does NOT re-run gauguin_cp_mem_setup (the cpmem/GEM page
+ * tables are DRAM state and survive the core reset) nor step22/panel/GEM
+ * selftest. gauguinrec caps the attempts (default 2, 0 = off).
+ */
+static int gg_rec_left = -1;	/* -1 unparsed; boot-arg gauguinrec */
+static int gg_rec_busy;		/* one recovery at a time */
+
+static bool
+gauguin_cp_recover(void)
+{
+	volatile uint32_t *ring = (volatile uint32_t *)(cpmem + CPMEM_RING);
+	unsigned i, wptr, rptr;
+	uint32_t rreg, flush, mw, val;
+	bool ok;
+
+	printf("GAUGUIN CP: 0171 recover start sqe=%#x rptr=%u wptr=%u"
+	    " fault=%#x\n",
+	    gg_rd(gg.gpu, GR(CP_SQE_CNTL_DW)),
+	    gg_rd(gg.gpu, GR(CP_RB_RPTR_DW)),
+	    gg_rd(gg.gpu, GR(CP_RB_WPTR_DW)),
+	    gg_rd(gg.gpu, GR(CP_HW_FAULT_DW)));
+	(void)sweet_log_flush_now();
+
+	/* Halt the ME and W1C the latches (0158 proved W1C cannot clear the
+	 * running ME's HW_FAULT; the zap below resets them anyway). */
+	gg_wr(gg.gpu, GR(CP_SQE_CNTL_DW), 0);
+	gg_wr(gg.gpu, GR(CP_INTERRUPT_STATUS_DW),
+	    gg_rd(gg.gpu, GR(CP_INTERRUPT_STATUS_DW)));
+	gg_wr(gg.gpu, GR(CP_HW_FAULT_DW), gg_rd(gg.gpu, GR(CP_HW_FAULT_DW)));
+
+	/* OOB GPU_SET (set bit 16, ack bit 24) - same as boot. */
+	gauguin_gmu_wr(G_H2G_INTR_SET, 1u << 16);
+	ok = false;
+	for (i = 0; i < 5000; ++i) {
+		if (gauguin_gmu_rd(G_INTR_INFO) & (1u << 24)) {
+			ok = true;
+			break;
+		}
+		delay(10);
+	}
+	printf("GAUGUIN CP: 0171 recover gpu_set acked=%d\n", ok);
+	(void)sweet_log_flush_now();
+	if (!ok) {
+		return false;
+	}
+
+	/* Core clock back on (redundant if it never stopped, harmless). */
+	gg_wr(gg.gpucc, GPUCC_GFX3D_SRC + 4u, 0x501u);
+	gg_wr(gg.gpucc, GPUCC_GFX3D_SRC, 1u);
+	for (i = 0; i < 1000 && (gg_rd(gg.gpucc, GPUCC_GFX3D_SRC) & 1u); ++i) {
+		delay(10);
+	}
+	gg_wr(gg.gpucc, GPUCC_GFX3D_CBCR,
+	    gg_rd(gg.gpucc, GPUCC_GFX3D_CBCR) | 1u);
+
+	/* hw_init write set - identical to boot cp_start (readback-verified). */
+	CP_WRV(UCHE_WRITE_RANGE_MAX_LO_DW, 0xffffffc0);
+	gg_wr(gg.gpu, GR(UCHE_WRITE_RANGE_MAX_LO_DW) + 4u, 0x0001ffff);
+	CP_WRV(UCHE_TRAP_BASE_LO_DW, 0xfffff000);
+	gg_wr(gg.gpu, GR(UCHE_TRAP_BASE_LO_DW) + 4u, 0x0001ffff);
+	gg_wr(gg.gpu, GR(UCHE_WRITE_THRU_BASE_LO_DW), 0xfffff000);
+	gg_wr(gg.gpu, GR(UCHE_WRITE_THRU_BASE_LO_DW) + 4u, 0x0001ffff);
+	CP_WRV(UCHE_FILTER_CNTL_DW, 0x804);
+	CP_WRV(UCHE_CACHE_WAYS_DW, 0x4);
+	CP_WRV(CP_ROQ_THRESHOLDS_1_DW, 0x8040362c);
+	CP_WRV(CP_MEM_POOL_SIZE_DW, 128);
+	CP_WRV(PC_DBG_ECO_CNTL_DW, 0x00200200);
+	CP_WRV(CP_AHB_CNTL_DW, 0x1);
+	CP_WRV(CP_CHICKEN_DBG_DW, 0x1);
+	CP_WRV(RB_DBG_ECO_CNTL_DW, 0x04100000);
+	CP_WRV(RBBM_PERFCTR_CNTL_DW, 0x1);
+	CP_WRV(RBBM_PERFCTR_GPU_BUSY_MASKED_DW, 0xffffffff);
+	CP_WRV(RB_NC_MODE_CNTL_DW, 0x812);
+	CP_WRV(TPL1_NC_MODE_CNTL_DW, 0x2);
+	CP_WRV(SP_NC_MODE_CNTL_DW, 0x22);
+	CP_WRV(UCHE_MODE_CNTL_DW, 1u << 21);
+	CP_WRV(RBBM_INTERFACE_HANG_INT_CNTL_DW, 0x401fffff);
+	CP_WRV(UCHE_CLIENT_PF_DW, 0x81);
+	if (!ok) {
+		printf("GAUGUIN CP: 0171 recover hw_init FAIL\n");
+		(void)sweet_log_flush_now();
+		return false;
+	}
+
+	/* secvid + 64-bit addr modes + QoS/GBIF - identical to boot. */
+	gg_wr(gg.gpu, GR(RBBM_SECVID_TSB_LO_DW), 0);
+	gg_wr(gg.gpu, GR(RBBM_SECVID_TSB_LO_DW) + 4u, 0);
+	gg_wr(gg.gpu, GR(RBBM_SECVID_TSB_SZ_DW), 0);
+	gg_wr(gg.gpu, GR(RBBM_SECVID_TSB_CNTL_DW), 0);
+	{
+		static const uint32_t addr_modes[] = {
+			0x0842u, 0x0c01u, 0x8601u, 0x8e05u, 0x9e01u, 0xbe05u,
+			0xa601u, 0x9601u, 0x0e00u, 0xae01u, 0xb601u, 0xf810u,
+		};
+		unsigned m;
+
+		for (m = 0; m < sizeof(addr_modes) / sizeof(addr_modes[0]);
+		    ++m) {
+			gg_wr(gg.gpu, GR(addr_modes[m]), 1u);
+		}
+	}
+	gg_wr(gg.gpu, GR(RBBM_VBIF_CLIENT_QOS_CNTL_DW), 3);
+	gg_wr(gg.gpu, GR(RBBM_GBIF_CLIENT_QOS_CNTL_DW), 3);
+	gg_wr(gg.gpu, GR(GBIF_QSB_SIDE_DW), 0x00071620);
+	gg_wr(gg.gpu, GR(GBIF_QSB_SIDE_DW) + 4u, 0x00071620);
+	gg_wr(gg.gpu, GR(GBIF_QSB_SIDE_DW) + 8u, 0x00071620);
+	gg_wr(gg.gpu, GR(GBIF_QSB_SIDE_DW) + 12u, 0x00071620);
+	gg_wr(gg.gpu, GR(GBIF_HALT_DW), 0);
+	gg_wr(gg.gpu, GR(RBBM_GBIF_HALT_DW), 0);
+	gg_wr(gg.gpu, GR(RBBM_GBIF_CLIENT_QOS_CNTL_DW), 0);
+
+	/* RB setup - identical to boot. */
+	gg_wr(gg.gpu, GR(CP_RB_RPTR_ADDR_DW), CP_VA_SCRATCH);
+	gg_wr(gg.gpu, GR(CP_RB_RPTR_ADDR_DW) + 4u, 0);
+	gg_wr(gg.gpu, GR(CP_RB_CNTL_DW), RB_CNTL_VAL);
+	gg_wr(gg.gpu, GR(CP_RB_BASE_DW), CP_VA_RING);
+	gg_wr(gg.gpu, GR(CP_RB_BASE_DW) + 4u, 0);
+	gg_wr(gg.gpu, GR(CP_SQE_INSTR_BASE_DW), CP_VA_SQE);
+	gg_wr(gg.gpu, GR(CP_SQE_INSTR_BASE_DW) + 4u, 0);
+
+	/* v41 lesson: zap while SQE_CNTL is still 0. PAS 13 was shut down
+	 * after the boot selftest, so this re-runs the full INIT/MEM_SETUP/
+	 * AUTH sequence on the cached block (see gauguin_zap_load). */
+	if (!gauguin_zap_load()) {
+		printf("GAUGUIN CP: 0171 recover zap failed\n");
+		(void)sweet_log_flush_now();
+		return false;
+	}
+	printf("GAUGUIN CP: 0171 recover zap done sqe=%#x rptr=%u wptr=%u"
+	    " fault=%#x int=%#x\n",
+	    gg_rd(gg.gpu, GR(CP_SQE_CNTL_DW)),
+	    gg_rd(gg.gpu, GR(CP_RB_RPTR_DW)),
+	    gg_rd(gg.gpu, GR(CP_RB_WPTR_DW)),
+	    gg_rd(gg.gpu, GR(CP_HW_FAULT_DW)),
+	    gg_rd(gg.gpu, GR(CP_INTERRUPT_STATUS_DW)));
+	(void)sweet_log_flush_now();
+
+	gg_wr(gg.gpu, GR(CP_SQE_CNTL_DW), 1);
+
+	/* ME_INIT + WAI - identical to boot. */
+	ring[0] = gg_pkt7(0x48u, 8u);
+	ring[1] = 0x2fu;
+	ring[2] = 0x00000003;
+	ring[3] = 0x20000000;
+	ring[4] = 0x00000000;
+	ring[5] = 0x00000000;
+	ring[6] = 0x00000000;
+	ring[7] = 0x00000000;
+	ring[8] = 0x00000000;
+	ring[9] = gg_pkt7(0x62u, 2u);
+	ring[10] = (uint32_t)(CP_VA_SCRATCH & 0xffffffffu);
+	ring[11] = 0u;
+	__asm__ volatile("dmb oshst" ::: "memory");
+	wptr = 12;
+	gg_wr(gg.gpu, GR(CP_RB_WPTR_DW), wptr);
+	ok = false;
+	for (i = 0; i < 2000; ++i) {
+		flush_dcache64((addr64_t)(cpmem + CPMEM_SCRATCH), 64, FALSE);
+		rptr = *(volatile uint32_t *)(cpmem + CPMEM_SCRATCH);
+		rreg = gg_rd(gg.gpu, GR(CP_RB_RPTR_DW));
+		if (rptr == wptr || rreg == wptr) {
+			ok = true;
+			break;
+		}
+		delay(1000);
+	}
+	printf("GAUGUIN CP: 0171 recover ME_INIT %s (rptr=%u reg=%#x"
+	    " wptr=%u)\n", ok ? "RETIRED" : "STUCK", rptr, rreg, wptr);
+	(void)sweet_log_flush_now();
+	if (!ok) {
+		return false;
+	}
+
+	/* SET_SECURE_MODE + WAI - identical to boot. */
+	ring[12] = gg_pkt7(0x66u, 1u);
+	ring[13] = 0u;
+	ring[14] = gg_pkt7(0x62u, 2u);
+	ring[15] = (uint32_t)(CP_VA_SCRATCH & 0xffffffffu);
+	ring[16] = 0u;
+	__asm__ volatile("dmb oshst" ::: "memory");
+	wptr = 17;
+	gg_wr(gg.gpu, GR(CP_RB_WPTR_DW), wptr);
+	ok = false;
+	for (i = 0; i < 2000; ++i) {
+		flush_dcache64((addr64_t)(cpmem + CPMEM_SCRATCH), 64, FALSE);
+		rptr = *(volatile uint32_t *)(cpmem + CPMEM_SCRATCH);
+		rreg = gg_rd(gg.gpu, GR(CP_RB_RPTR_DW));
+		if (rptr == wptr || rreg == wptr) {
+			ok = true;
+			break;
+		}
+		delay(1000);
+	}
+	printf("GAUGUIN CP: 0171 recover SET_SECURE_MODE %s (rptr=%u reg=%#x"
+	    " wptr=%u)\n", ok ? "RETIRED" : "STUCK", rptr, rreg, wptr);
+	(void)sweet_log_flush_now();
+	if (!ok) {
+		return false;
+	}
+
+	/* memwrite + CACHE_FLUSH_TS probe - the boot-proven retirement test. */
+	ring[17] = gg_pkt7(0x3du, 3u);
+	ring[18] = (uint32_t)((CP_VA_SCRATCH + 0x120u) & 0xffffffffu);
+	ring[19] = 0u;
+	ring[20] = 0x600dc0deu;
+	ring[21] = gg_pkt7(0x46u, 4u);
+	ring[22] = 0x04u;
+	ring[23] = (uint32_t)((CP_VA_SCRATCH + 0x130u) & 0xffffffffu);
+	ring[24] = 0u;
+	ring[25] = 0x600df1a5u;
+	__asm__ volatile("dmb oshst" ::: "memory");
+	gg_wr(gg.gpu, GR(CP_RB_WPTR_DW), 26u);
+	flush = 0u;
+	for (i = 0; i < 2000; ++i) {
+		flush_dcache64((addr64_t)(cpmem + CPMEM_SCRATCH + 0x100u),
+		    64, FALSE);
+		flush = *(volatile uint32_t *)(cpmem + CPMEM_SCRATCH + 0x130u);
+		if (flush == 0x600df1a5u) {
+			break;
+		}
+		delay(1000);
+	}
+	flush_dcache64((addr64_t)(cpmem + CPMEM_SCRATCH + 0x120u), 64, FALSE);
+	mw = *(volatile uint32_t *)(cpmem + CPMEM_SCRATCH + 0x120u);
+	printf("GAUGUIN CP: 0171 recover memwrite=%#x flush=%#x tries=%u"
+	    " fault=%#x int=%#x status1=%#x\n", mw, flush, i,
+	    gg_rd(gg.gpu, GR(CP_HW_FAULT_DW)),
+	    gg_rd(gg.gpu, GR(CP_INTERRUPT_STATUS_DW)),
+	    gg_rd(gg.gpu, GR(CP_STATUS_1_DW)));
+	(void)sweet_log_flush_now();
+	return flush == 0x600df1a5u && mw == 0x600dc0deu;
+}
