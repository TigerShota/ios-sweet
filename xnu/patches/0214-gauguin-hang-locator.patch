+/*
+ * 0214: v164's SMMU record has been stuck at fsr=0x400 / far=0 since boot and the
+ * 106th submit died with the CPU inside a status read, so the question is which
+ * address the stream asked the GPU to touch that is not there. Walk the buffer
+ * the CP will actually execute (the annotated/flattened copy when mark=1) and
+ * check only the fields that are addresses by construction - indirect-buffer
+ * base, CACHE_FLUSH_TS target, CP_SET_DRAW_STATE descriptors. A zero or an
+ * unmapped GEM-window address is printed with its submit fence and offset.
+ * Report-only on purpose: a blanket "any dword that looks like a VA" scan would
+ * flag colours and constants, and refusing the submit would stop the very
+ * rendering that is making progress.
+ */
+static uint32_t gg_iov_hits;	/* 0214: suspicious address fields printed */
+
+static void
+gg_chk_addr(uint32_t fence, uint32_t off, uint32_t lo, uint32_t hi,
+    const char *what)
+{
+	uint64_t a = ((uint64_t)hi << 32) | (uint64_t)lo;
+
+	if (gg_iov_hits >= 8u) {
+		return;
+	}
+	if (a == 0u || (a >= 0x50000000u && a < 0x70000000u &&
+	    gg_gem_pa(a) == 0u)) {
+		gg_iov_hits++;
+		printf("GAUGUIN CP: 0214 iov fence=%#x off=%u %s addr=%#llx %s\n",
+		    fence, off, what, (unsigned long long)a,
+		    a == 0u ? "zero" : "unmapped");
+	}
+}
+
+static void
+gg_cmd_addr_check(uint32_t fence, volatile uint32_t *cp, uint32_t n)
+{
+	uint32_t o = 0u;
+
+	while (o < n) {
+		uint32_t h = cp[o];
+		uint32_t type = h >> 28u;
+		uint32_t op = (h >> 16) & 0x7fu;
+		uint32_t plen;
+
+		if (type == 7u) {
+			plen = h & 0x3fffu;
+		} else if (type == 4u) {
+			plen = h & 0x7fu;
+		} else if (type == 0u) {
+			plen = ((h >> 16) & 0x3fffu) + 1u;
+		} else {
+			return;
+		}
+		if (o + 1u + plen > n) {
+			return;
+		}
+		if (type == 7u && (op == 0x3fu || op == 0x37u || op == 0x63u) &&
+		    plen >= 3u) {
+			gg_chk_addr(fence, o, cp[o + 1u], cp[o + 2u], "ib");
+		} else if (type == 7u && op == CP_EVENT_WRITE && plen >= 3u) {
+			gg_chk_addr(fence, o, cp[o + 2u], cp[o + 3u], "ev");
+		} else if (type == 7u && op == 0x43u && plen >= 3u) {
+			uint32_t g, groups = plen / 3u;
+
+			for (g = 0; g < groups; g++) {
+				gg_chk_addr(fence, o, cp[o + 2u + 3u * g],
+				    cp[o + 3u + 3u * g], "sds");
+			}
+		}
+		o += 1u + plen;
+	}
+}
