diff --git a/bsd/dev/gauguin_gpu.c b/bsd/dev/gauguin_gpu.c
--- a/bsd/dev/gauguin_gpu.c
+++ b/bsd/dev/gauguin_gpu.c
@@ -3324,6 +3324,19 @@ gg_ib_map(uint64_t iova, uint32_t dwords)
 	return base + (vm_offset_t)(iova & 0xfffu);
 }
 
+/*
+ * 0151: gg_ib_map() refuses a buffer that runs off the end of its page, which
+ * silently hid the 65615-dword buffer behind 0x50416600. Clip to the page
+ * instead so at least the first commands of any IB are visible.
+ */
+static uint32_t
+gg_ib_room(uint64_t iova, uint32_t dwords)
+{
+	uint32_t room = (uint32_t)((GEM_PAGE - (uint32_t)(iova & 0xfffu)) / 4u);
+
+	return dwords < room ? dwords : room;
+}
+
