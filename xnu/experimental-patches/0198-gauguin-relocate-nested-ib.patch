+/*

+ * 0198: copy a nested command buffer into the mark block. The mark block is

+ * mapped in the CP's own L3 (CP_VA_MARK), so the ME fetches the copy through

+ * the same path as the annotated top-level IB; the original GEM IOVA is not

+ * reachable as an IB2. Returns the byte offset in the mark block, or 0.

+ */

+static uint32_t

+gg_reloc_ib(uint64_t src, uint32_t dwords)

+{

+	uint32_t off = gg_reloc_off, o;

+

+	if (mark_mem == 0 || dwords == 0u || dwords > GG_SAN_MAX_DW) {

+		return 0u;

+	}

+	if (off < GG_MARK_IB || off + 4u * dwords > CPMEM_MARK_SIZE) {

+		return 0u;

+	}

+	for (o = 0; o < dwords; o++) {

+		*(volatile uint32_t *)(mark_mem + off + 4u * (vm_offset_t)o) =

+		    gg_san_rd2(src, 0, 0, o);

+	}

+	gg_reloc_off = off + 4u * dwords;

+	gg_reloc_dirty = 1;

+	/*

+	 * The mark block is WCOMB. Clean the copy now: the sanitizer may make

+	 * no further edit to it, so its own "fixed" flush would not run.

+	 */

+	flush_dcache64((addr64_t)(mark_pa + off), 4u * dwords, TRUE);

+	return off;

+}

