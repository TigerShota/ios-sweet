+/*
+ * 0141: a submit that times out (the kernel's CP completion fence never landed) wedges the GPU for good: every later
+ * submit times out the same way, so the command stream of the BO at that moment is the only evidence of what the CP
+ * choked on. When a single-command submit fails, read that stream back through the mapping Mesa already has (or map
+ * it here) and print it, together with the dwords that differ from the last stream that completed. 4 dumps.
+ */
+#define SWD_IB_WORDS   128u     /* 512 bytes: the per-frame streams seen so far are 68 dwords */
+#define SWD_IB_DUMPS   4
+
+static int g_ib_dumps;
+static struct {
+	uint32_t handle, offset, n;
+	uint32_t w[SWD_IB_WORDS];
+} g_ib_last;
+
+static const uint8_t *
+swd_bo_view(uint32_t handle, size_t need, mach_vm_address_t *mapped)
+{
+	pthread_mutex_lock(&g_lock);
+	for (unsigned i = 0; i < g_nmaps; i++) {
+		if (g_maps[i].handle == handle && g_maps[i].len >= need) {
+			const uint8_t *p = (const uint8_t *)g_maps[i].addr;
+			pthread_mutex_unlock(&g_lock);
+			*mapped = 0;
+			return p;
+		}
+	}
+	pthread_mutex_unlock(&g_lock);
+	mach_vm_address_t a = 0;
+	mach_vm_size_t s = (mach_vm_size_t)((need + 0xfffu) & ~(size_t)0xfffu);
+	if (!connect_once() ||
+	    IOConnectMapMemory64(g_conn, handle, mach_task_self(), &a, &s,
+	    kIOMapAnywhere | kIOMapWriteCombineCache) != KERN_SUCCESS) {
+		return NULL;
+	}
+	*mapped = a;
+	return (const uint8_t *)(uintptr_t)a;
+}
+
+static void
+swd_bo_view_done(uint32_t handle, mach_vm_address_t mapped)
+{
+	if (mapped) {
+		IOConnectUnmapMemory64(g_conn, handle, mach_task_self(), mapped);
+	}
+}
+
+/* The first MSM_SUBMIT_CMD_BUF of a one-command submit, when it fits the snapshot. */
+static int
+swd_ib_pick(const struct sweet_msm_gem_submit *req, uint32_t *handle, uint32_t *offset,
+    uint32_t *nwords, uint32_t *nrelocs)
+{
+	const struct sweet_msm_gem_submit_cmd *cmds = (const void *)(uintptr_t)req->cmds;
+	const struct sweet_msm_gem_submit_bo *bos = (const void *)(uintptr_t)req->bos;
+
+	if (req->nr_cmds != 1 || req->nr_bos == 0 || req->cmds == 0 || req->bos == 0) {
+		return 0;
+	}
+	if (cmds[0].type != 1 /* MSM_SUBMIT_CMD_BUF */ || cmds[0].submit_idx >= req->nr_bos ||
+	    cmds[0].size == 0 || cmds[0].size > SWD_IB_WORDS * 4) {
+		return 0;
+	}
+	*handle = bos[cmds[0].submit_idx].handle;
+	*offset = cmds[0].submit_offset;
+	*nwords = cmds[0].size / 4;
+	*nrelocs = cmds[0].nr_relocs;
+	return 1;
+}
+
+static uint64_t
+swd_iova(uint32_t handle)
+{
+	struct sweet_msm_gem_info gi;
+
+	memset(&gi, 0, sizeof(gi));
+	gi.handle = handle;
+	gi.info = SWEET_MSM_INFO_GET_IOVA;
+	return sweet_call(SWEET_GPU_SEL_GEM_INFO, &gi, sizeof(gi)) == 0 ? gi.value : 0;
+}
+
+static void
+swd_ib_print(const char *tag, const uint32_t *w, uint32_t n)
+{
+	char line[160];
+
+	for (uint32_t i = 0; i < n; i += 8) {
+		int p = snprintf(line, sizeof(line), "swd: %s[%02u]", tag, i);
+		for (uint32_t j = i; j < n && j < i + 8; j++) {
+			p += snprintf(line + p, sizeof(line) - (size_t)p, " %08x", w[j]);
+		}
+		fprintf(stderr, "%s\n", line);
+	}
+}
